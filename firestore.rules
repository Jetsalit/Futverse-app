            'updatedBy',
            'updatedByRole'
          ]);
      }

      function proClubMatchValidStartingXIDataV1(data, rosterPlayerKeys) {
        let slotPlayerKeys = data.get('slotPlayerKeys', []);
        let starters = slotPlayerKeys.removeAll([null]);
        let substitutes = data.get('substitutePlayerKeys', []);
        let selected = starters.concat(substitutes);
        return slotPlayerKeys is list
          && slotPlayerKeys.size() == 11
          && substitutes is list
          // One selected-player set proves uniqueness and no overlap.
          && proClubMatchValidRoleAssignmentsV1(
            data.get('positionRoleAssignments', [])
          )
          && selected.toSet().size() == selected.size()
          && rosterPlayerKeys.hasAll(selected)
          && proClubMatchStartingXIKeysV1(data)
          && data.get('schemaVersion', 0) == 1
          && data.get('formation', '') in [
            '4-3-3',
            '4-2-3-1',
            '4-4-2',
            '3-5-2',
            'CUSTOM'
          ]
          && proClubMatchValidCustomFormationSlotsV1(
            data.get('formation', ''),
            data.get('customFormationSlots', null)
          )
          && proClubMatchValidSetPiecesV1(
            data.get('setPieceAssignments', {}),
            selected
          )
          && proClubGameModelPhasesValidV1(
            data.get('gameModelSnapshot', {})
          )
          && data.get('coachNotes', '') is string
          && data.get('coachNotes', '').size() <= 2000
          && data.get('coachNotes', '').trim()
            == data.get('coachNotes', '')
          && data.get('matchRosterRevision', -1) is int
          && data.get('matchRosterRevision', -1) >= 0
          && data.get('revision', 0) is int
          && data.get('revision', 0) >= 1;
      }

      function proClubMatchValidStartingXICreateV1(matchId) {
        let data = request.resource.data;
        let matchPath =
          /databases/$(database)/documents/proClubs/$(clubId)/matches/$(matchId);
        let matchData = get(matchPath).data;
        let actorRole = proClubMatchActorRoleV1(clubId);
        // matchData validation fails closed when Match is absent.
        return proClubMatchRosterIndexStateV1(matchData)
          && matchData.get('status', '') in ['DRAFT', 'SCHEDULED']
          && proClubMatchValidStartingXIDataV1(
            data,
            matchData.get('rosterPlayerKeys', [])
          )
          && data.get('matchRosterRevision', -1)
            == matchData.get('rosterRevision', -2)
          && data.get('revision', 0) == 1
          && data.get('createdAt', null) == request.time
          && data.get('createdBy', '') == request.auth.uid
          && data.get('createdByRole', '') == actorRole
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid
          && data.get('updatedByRole', '') == actorRole;
      }

