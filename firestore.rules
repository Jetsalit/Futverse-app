          && phases.get('IN_POSSESSION', '') is string
          && phases.get('IN_POSSESSION', '').size() <= 4000
          && phases.get('OUT_OF_POSSESSION', '') is string
          && phases.get('OUT_OF_POSSESSION', '').size() <= 4000
          && phases.get('TRANSITION_TO_ATTACK', '') is string
          && phases.get('TRANSITION_TO_ATTACK', '').size() <= 4000
          && phases.get('TRANSITION_TO_DEFEND', '') is string
          && phases.get('TRANSITION_TO_DEFEND', '').size() <= 4000;
