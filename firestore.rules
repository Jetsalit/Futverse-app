rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserIsActive() {
      return isSignedIn()
        && userExists(request.auth.uid)
        && currentUserData().get('status', '') in ['Active', 'ACTIVE'];
    }

    function isSuperAdmin() {
      return currentUserIsActive()
        && currentUserData().get('role', '') == 'SUPERADMIN';
    }

    function isAdmin() {
      return currentUserIsActive()
        && currentUserData().get('role', '') in ['SUPERADMIN', 'ADMIN'];
    }

    function isOwnUserDocument(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validInviteCode(inviteCode) {
      return inviteCode is string
        && inviteCode.size() <= 32
        && inviteCode.matches('^FUT-[A-Z0-9-]+$');
    }

    function exactDocumentId(value) {
      return value is string
        && value.size() > 0
        && value.matches('^[^/]+$');
    }

    function validIssuedFutIdV1(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 64
        && value.matches('^FUT-[A-Z0-9]+(-[A-Z0-9]+)*$');
    }

    function validPlayerIdentityKeyV1(value) {
      return exactDocumentId(value)
        && !value.matches('^\\s.*')
        && !value.matches('.*\\s$');
    }

    function validPlayerIdentityCreateData(playerKey) {
      let data = request.resource.data;
      let futId = data.get('futId', '');
      let registryPath =
        /databases/$(database)/documents/futIdRegistry/$(futId);

      return isSuperAdmin()
        && validPlayerIdentityKeyV1(playerKey)
        && data.keys().hasAll([
          'schemaVersion',
          'futId',
          'source',
          'createdAt',
          'createdBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'futId',
          'source',
          'createdAt',
          'createdBy'
        ])
        && data.schemaVersion == 1
        && validIssuedFutIdV1(futId)
        && data.source in [
          'SUPERADMIN_ISSUANCE',
          'LEGACY_MIGRATION'
        ]
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.createdBy == request.auth.uid

        // The counterpart must not have existed before this atomic write.
        && !exists(registryPath)

        // It must exist after the same atomic write.
        && existsAfter(registryPath)

        // Both sides must describe the same lifelong identity.
        && getAfter(registryPath).data.get('schemaVersion', 0) == 1
        && getAfter(registryPath).data.get('futId', '') == futId
        && getAfter(registryPath).data.get('playerKey', '') == playerKey
        && getAfter(registryPath).data.get('createdBy', '')
          == request.auth.uid;
    }

    function validFutIdRegistryCreateData(futId) {
      let data = request.resource.data;
      let playerKey = data.get('playerKey', '');
      let identityPath =
        /databases/$(database)/documents/playerIdentities/$(playerKey);

      return isSuperAdmin()
        && validIssuedFutIdV1(futId)
        && data.keys().hasAll([
          'schemaVersion',
          'futId',
          'playerKey',
          'createdAt',
          'createdBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'futId',
          'playerKey',
          'createdAt',
          'createdBy'
        ])
        && data.schemaVersion == 1
        && data.futId == futId
        && validPlayerIdentityKeyV1(playerKey)
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.createdBy == request.auth.uid

        // The identity must also be new in this atomic write.
        && !exists(identityPath)

        // It must exist after the same atomic write.
        && existsAfter(identityPath)

        // Registry and identity must mutually agree.
        && getAfter(identityPath).data.get('schemaVersion', 0) == 1
        && getAfter(identityPath).data.get('futId', '') == futId
        && getAfter(identityPath).data.get('createdBy', '')
          == request.auth.uid;
    }
    function hasNoStoredDocumentId() {
      return !request.resource.data.keys().hasAny(['id']);
    }

    function hasCanonicalUserUid(uid) {
      return !request.resource.data.keys().hasAny(['uid'])
        || (
          request.resource.data.uid is string
          && request.resource.data.uid == uid
        );
    }

    function activeInviteMatchesAcademy(inviteCode, academyId) {
      return validInviteCode(inviteCode)
        && exactDocumentId(academyId)
        && exists(
          /databases/$(database)/documents/academy_invites/$(inviteCode)
        )
        && get(
          /databases/$(database)/documents/academy_invites/$(inviteCode)
        ).data.get('inviteCode', '') == inviteCode
        && get(
          /databases/$(database)/documents/academy_invites/$(inviteCode)
        ).data.get('academyId', '') == academyId
        && get(
          /databases/$(database)/documents/academy_invites/$(inviteCode)
        ).data.get('status', '') == 'ACTIVE';
    }

    function isActiveAcademyMember(academyId) {
      let membership = get(
        /databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)
      ).data;
      return currentUserIsActive()
        && exists(
          /databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)
        )
        && membership.get('userId', '') == request.auth.uid
        && membership.get('academyId', '') == academyId
        && membership.get('status', '') == 'ACTIVE'
        && membership.get('role', '') in ['ADMIN', 'COACH'];
    }

    function hasAcademyRole(academyId, roles) {
      return isActiveAcademyMember(academyId)
        && get(
          /databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)
        ).data.role in roles;
    }

    function academyStaffSpecialtyActorCanManageV1(academyId) {
      return isSuperAdmin()
        || hasAcademyRole(academyId, ['ADMIN']);
    }

    function academyStaffSpecialtyTargetIsActiveCoachV1(academyId, uid) {
      let membershipPath =
        /databases/$(database)/documents/academies/$(academyId)/members/$(uid);
      let membership = get(membershipPath).data;

      return exactDocumentId(academyId)
        && exactDocumentId(uid)
        && exists(membershipPath)
        && membership.get('userId', '') == uid
        && membership.get('academyId', '') == academyId
        && membership.get('role', '') == 'COACH'
        && membership.get('status', '') == 'ACTIVE';
    }

    function validAcademyFitnessCoachSpecialtyDataV1(uid, data) {
      return exactDocumentId(uid)
        && data.keys().hasAll([
          'schemaVersion',
          'specialty',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'specialty',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.schemaVersion == 1
        && data.specialty == 'FITNESS_COACH'
        && data.status in ['ACTIVE', 'INACTIVE', 'LEFT']
        && data.createdAt is timestamp
        && exactDocumentId(data.createdBy)
        && data.updatedAt is timestamp
        && exactDocumentId(data.updatedBy);
    }

    function validAcademyFitnessCoachSpecialtyCreateV1(academyId, uid) {
      return academyStaffSpecialtyActorCanManageV1(academyId)
        && academyStaffSpecialtyTargetIsActiveCoachV1(academyId, uid)
        && validAcademyFitnessCoachSpecialtyDataV1(
          uid,
          request.resource.data
        )
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validAcademyFitnessCoachSpecialtyTransitionV1(
      fromStatus,
      toStatus
    ) {
      return (
          fromStatus == 'ACTIVE'
          && toStatus in ['ACTIVE', 'INACTIVE', 'LEFT']
        )
        || (
          fromStatus == 'INACTIVE'
          && toStatus in ['INACTIVE', 'ACTIVE', 'LEFT']
        );
    }

    function validAcademyFitnessCoachSpecialtyUpdateV1(academyId, uid) {
      return academyStaffSpecialtyActorCanManageV1(academyId)
        && validAcademyFitnessCoachSpecialtyDataV1(uid, resource.data)
        && validAcademyFitnessCoachSpecialtyDataV1(
          uid,
          request.resource.data
        )
        && validAcademyFitnessCoachSpecialtyTransitionV1(
          resource.data.status,
          request.resource.data.status
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.specialty == resource.data.specialty
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          request.resource.data.status != 'ACTIVE'
          || academyStaffSpecialtyTargetIsActiveCoachV1(academyId, uid)
        );
    }

    // Academy Fitness Results V1 — append-only observed football fitness data.
    function validAcademyFitnessIdentifierV1(value) {
      return exactDocumentId(value)
        && !value.matches('^[\\s\\p{Z}\\x{FEFF}][\\s\\S]*$')
        && !value.matches('^[\\s\\S]*[\\s\\p{Z}\\x{FEFF}]$');
    }

    function validAcademyFitnessDefinitionIdV1(value) {
      return validAcademyFitnessIdentifierV1(value);
    }

    function validAcademyFitnessObservedOnV1(value) {
      let parsed = timestamp.date(
        int(value[0:4]),
        int(value[5:7]),
        int(value[8:10])
      );

      return value is string
        && value.matches(
          '^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))$'
        )
        && parsed.year() == int(value[0:4])
        && parsed.month() == int(value[5:7])
        && parsed.day() == int(value[8:10]);
    }

    function validAcademyFitnessResultValueV1(value) {
      return value is number
        && value * 0 == 0;
    }

    function academyFitnessResultIdentitySeedV1(data) {
      return 'fitness-result-v1|'
        + string(data.playerId.toUtf8().size())
        + ':'
        + data.playerId
        + '|'
        + data.observedOn
        + '|'
        + string(data.definitionId.toUtf8().size())
        + ':'
        + data.definitionId
        + '|'
        + string(data.definitionVersion);
    }

    function academyFitnessResultIdMatchesV1(resultId, data) {
      return resultId == 'fit-v1-'
        + hashing.sha256(
          academyFitnessResultIdentitySeedV1(data)
        ).toHexString().lower();
    }

    function academyFitnessResultPlayerExistsV1(academyId, playerId) {
      let playerPath =
        /databases/$(database)/documents/academies/$(academyId)/players/$(playerId);

      return validAcademyFitnessIdentifierV1(playerId)
        && exists(playerPath);
    }

    function validAcademyFitnessResultCreateV1(academyId, resultId) {
      let data = request.resource.data;

      return exactDocumentId(resultId)
        && tenantFootballCanWrite(academyId)
        && data.keys().hasAll([
          'schemaVersion',
          'playerId',
          'definitionId',
          'definitionVersion',
          'value',
          'observedOn',
          'source',
          'recordedAt',
          'recordedBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'playerId',
          'definitionId',
          'definitionVersion',
          'value',
          'observedOn',
          'source',
          'recordedAt',
          'recordedBy'
        ])
        && data.schemaVersion == 1
        && academyFitnessResultPlayerExistsV1(
          academyId,
          data.playerId
        )
        && validAcademyFitnessDefinitionIdV1(data.definitionId)
        && data.definitionVersion is int
        && data.definitionVersion > 0
        && validAcademyFitnessResultValueV1(data.value)
        && validAcademyFitnessObservedOnV1(data.observedOn)
        && data.source == 'ACADEMY_BULK_ENTRY'
        && data.recordedAt is timestamp
        && data.recordedAt == request.time
        && exactDocumentId(data.recordedBy)
        && data.recordedBy == request.auth.uid
        && academyFitnessResultIdMatchesV1(
          resultId,
          data
        );
    }
    function tenantMemberCanRead(academyId) {
      return isSuperAdmin() || isActiveAcademyMember(academyId);
    }

    function tenantFootballCanWrite(academyId) {
      return isSuperAdmin()
        || hasAcademyRole(academyId, ['ADMIN', 'COACH']);
    }
    function validMatchText(value, maxSize) {
      return value is string
        && value.size() > 0
        && value.size() <= maxSize
        && !value.matches('^\\s.*')
        && !value.matches('.*\\s$');
    }

    function validOptionalMatchText(value, maxSize) {
      return value == null
        || validMatchText(value, maxSize);
    }

    function validOptionalEmptyMatchText(value, maxSize) {
      return value is string
        && value.size() <= maxSize
        && (
          value.size() == 0
          || validMatchText(value, maxSize)
        );
    }

    function validMatchScheduling(data) {
      return (
          data.status in ['SCHEDULED', 'IN_PROGRESS', 'COMPLETED']
          && validMatchText(data.opponentName, 120)
          && data.kickoffAt is timestamp
          && data.venueType in ['HOME', 'AWAY', 'NEUTRAL']
        )
        || (
          data.status in ['DRAFT', 'CANCELLED']
          && validOptionalMatchText(data.opponentName, 120)
          && (
            data.kickoffAt == null
            || data.kickoffAt is timestamp
          )
          && (
            data.venueType == null
            || data.venueType in ['HOME', 'AWAY', 'NEUTRAL']
          )
        );
    }

    function validMatchContractData(data) {
      return data.keys().hasAll([
          'schemaVersion',
          'status',
          'squadLabel',
          'competitionName',
          'opponentName',
          'kickoffAt',
          'venueType',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'status',
          'squadLabel',
          'competitionName',
          'opponentName',
          'kickoffAt',
          'venueType',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.schemaVersion == 1
        && data.status in [
          'DRAFT',
          'SCHEDULED',
          'IN_PROGRESS',
          'COMPLETED',
          'CANCELLED'
        ]
        && validMatchText(data.squadLabel, 80)
        && validMatchText(data.competitionName, 120)
        && validMatchScheduling(data)
        && data.createdAt is timestamp
        && exactDocumentId(data.createdBy)
        && data.updatedAt is timestamp
        && exactDocumentId(data.updatedBy);
    }

    function validMatchCreate() {
      return validMatchContractData(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validMatchTransition(fromStatus, toStatus) {
      return (
          fromStatus == toStatus
          && fromStatus in [
            'DRAFT',
            'SCHEDULED',
            'IN_PROGRESS'
          ]
        )
        || (
          fromStatus == 'DRAFT'
          && toStatus in [
            'SCHEDULED',
            'CANCELLED'
          ]
        )
        || (
          fromStatus == 'SCHEDULED'
          && toStatus in [
            'IN_PROGRESS',
            'CANCELLED'
          ]
        )
        || (
          fromStatus == 'IN_PROGRESS'
          && toStatus in [
            'COMPLETED',
            'CANCELLED'
          ]
        );
    }

    function validMatchUpdate() {
      return validMatchContractData(resource.data)
        && validMatchContractData(request.resource.data)
        && validMatchTransition(
          resource.data.status,
          request.resource.data.status
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function matchRosterIsMutable(academyId, matchId) {
      let matchPath =
        /databases/$(database)/documents/academies/$(academyId)/matches/$(matchId);
      let matchData = get(matchPath).data;

      return exists(matchPath)
        && matchData.get('schemaVersion', 0) == 1
        && matchData.get('status', '') in [
          'DRAFT',
          'SCHEDULED',
          'IN_PROGRESS'
        ];
    }

    function validStoredFutId(value) {
      return value == null
        || validMatchText(value, 64);
    }

    function academyPlayerFutIdCompatible(
      academyId,
      playerId,
      rosterFutId
    ) {
      let playerPath =
        /databases/$(database)/documents/academies/$(academyId)/players/$(playerId);
      let playerData = get(playerPath).data;
      let canonicalFutId =
        playerData.get('futId', null);
      let legacyFutId =
        playerData.get('futID', null);

      return exists(playerPath)
        && validStoredFutId(canonicalFutId)
        && validStoredFutId(legacyFutId)
        && (
          canonicalFutId == null
          || legacyFutId == null
          || canonicalFutId == legacyFutId
        )
        && (
          rosterFutId == null
          || (
            canonicalFutId != null
            && rosterFutId == canonicalFutId
          )
          || (
            canonicalFutId == null
            && legacyFutId != null
            && rosterFutId == legacyFutId
          )
        );
    }

    function validMatchRosterData(
      academyId,
      playerId,
      data
    ) {
      return data.keys().hasAll([
          'schemaVersion',
          'futId',
          'firstName',
          'lastName',
          'position',
          'jerseyNumber',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'futId',
          'firstName',
          'lastName',
          'position',
          'jerseyNumber',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.schemaVersion == 1
        && validStoredFutId(data.futId)
        && validMatchText(data.firstName, 80)
        && validOptionalEmptyMatchText(data.lastName, 80)
        && validMatchText(data.position, 32)
        && data.jerseyNumber is int
        && data.jerseyNumber >= 0
        && data.jerseyNumber <= 99
        && data.createdAt is timestamp
        && exactDocumentId(data.createdBy)
        && data.updatedAt is timestamp
        && exactDocumentId(data.updatedBy)
        && academyPlayerFutIdCompatible(
          academyId,
          playerId,
          data.futId
        );
    }

    function validMatchRosterCreate(
      academyId,
      playerId
    ) {
      return validMatchRosterData(
          academyId,
          playerId,
          request.resource.data
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validMatchRosterUpdate(
      academyId,
      playerId
    ) {
      return resource.data.get('schemaVersion', 0) == 1
        && validMatchRosterData(
          academyId,
          playerId,
          request.resource.data
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validNonStaffAssociationData(
      association,
      academyId,
      uid,
      playerId
    ) {
      return exactDocumentId(academyId)
        && exactDocumentId(uid)
        && exactDocumentId(playerId)
        && association.keys().hasAll([
          'userId', 'academyId', 'playerId', 'role', 'status'
        ])
        && association.keys().hasOnly([
          'userId', 'academyId', 'playerId', 'role', 'status'
        ])
        && association.userId == uid
        && association.academyId == academyId
        && association.playerId == playerId
        && association.role in ['PLAYER', 'PARENT']
        && association.status in ['ACTIVE', 'INACTIVE', 'REVOKED'];
    }

    function hasExactActiveNonStaffAssociation(academyId, playerId, role) {
      let associationPath = /databases/$(database)/documents/academies/$(academyId)/nonstaffUsers/$(request.auth.uid)/playerAssociations/$(playerId);
      let association = get(associationPath).data;
      return currentUserIsActive()
        && exactDocumentId(academyId)
        && exactDocumentId(playerId)
        && role in ['PLAYER', 'PARENT']
        && currentUserData().get('role', '') == role
        && exists(associationPath)
        && validNonStaffAssociationData(
          association,
          academyId,
          request.auth.uid,
          playerId
        )
        && association.role == role
        && association.status == 'ACTIVE';
    }

    function nonStaffAssociationTargetsExist(academyId, uid, playerId, role) {
      let targetUser = get(
        /databases/$(database)/documents/users/$(uid)
      ).data;
      return userExists(uid)
        && targetUser.get('uid', '') == uid
        && targetUser.get('role', '') == role
        && exists(
          /databases/$(database)/documents/academies/$(academyId)/players/$(playerId)
        );
    }

    function canReadAssociatedPlayer(academyId, playerId) {
      return hasExactActiveNonStaffAssociation(academyId, playerId, 'PLAYER')
        || hasExactActiveNonStaffAssociation(academyId, playerId, 'PARENT');
    }

    function safeOwnerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'displayName',
        'photoURL',
        'country',
        'phone',
        'lastLogin',
        'updatedAt',
        'pdpaAccepted',
        'pdpaAcceptedAt',
        'uid',
        'id'
      ]);
    }

    function registrationLogId(uid) {
      return 'user_registered_' + uid;
    }

    function validRegistrationRequestedRole(userData) {
      return userData.get('requestedRole', '') is string
        && userData.get('requestedRole', '') in [
          'COACH', 'PLAYER', 'SCOUT', 'PARENT'
        ];
    }

    function validRegistrationUserData(uid, userData) {
      return userData.get('uid', '') == uid
        && !userData.keys().hasAny(['id'])
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').size() > 0
        && userData.get('email', '') == request.auth.token.get('email', '')
        && validRegistrationRequestedRole(userData)
        && userData.get('academyId', null) == null
        && userData.get('activeAcademyId', null) == null
        && userData.get('tenantRole', null) == null
        && userData.get('subscriptionPlan', 'FREE') == 'FREE'
        && !userData.keys().hasAny([
          'maxPlayers',
          'paymentDetails'
        ])
        && (
          (
            userData.requestedRole == 'PLAYER'
            && userData.get('role', '') == 'PLAYER'
            && userData.get('status', '') == 'Active'
          )
          || (
            userData.requestedRole != 'PLAYER'
            && userData.get('role', '') == 'USER'
            && userData.get('status', '') == 'Inactive'
          )
        );
    }

    function validRegistrationUser(uid) {
      let logId = registrationLogId(uid);
      let logPath = /databases/$(database)/documents/logs/$(logId);
      return validRegistrationUserData(uid, request.resource.data)
        && !exists(/databases/$(database)/documents/users/$(uid))
        && !exists(logPath)
        && existsAfter(logPath)
        && validRegistrationLogData(
          logId,
          getAfter(logPath).data,
          request.resource.data
        );
    }

    function userPointerUpdateMatchesActiveMembership(uid) {
      let academyId = request.resource.data.get('activeAcademyId', '');
      let membership = get(
        /databases/$(database)/documents/academies/$(academyId)/members/$(uid)
      ).data;
      let claimId = membership.get('approvalClaimId', '');
      return academyId != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeAcademyId',
          'academyId',
          'tenantRole',
          'role',
          'status',
          'updatedAt',
          'uid',
          'id'
        ])
        && exists(
          /databases/$(database)/documents/academies/$(academyId)/members/$(uid)
        )
        && membership.get('status', '') == 'ACTIVE'
        && membership.get('userId', '') == uid
        && membership.get('academyId', '') == academyId
        && membership.get('role', '') in ['ADMIN', 'COACH']
        && membership.get('source', '') == 'CLAIM_APPROVAL'
        && exactDocumentId(claimId)
        && exists(
          /databases/$(database)/documents/profile_claims/$(claimId)
        )
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get('status', '') == 'APPROVED'
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get('userId', '') == uid
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get('approvedAcademyId', '') == academyId
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get('approvedRole', '') == membership.get('role', '')
        && activeInviteMatchesAcademy(
          get(
            /databases/$(database)/documents/profile_claims/$(claimId)
          ).data.get('inviteCode', ''),
          academyId
        )
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get(
          'requestedAcademyId',
          academyId
        ) == academyId
        && request.resource.data.get('academyId', '') == academyId
        && request.resource.data.get('tenantRole', '') == membership.role
        && request.resource.data.get('role', '') == membership.role
        && request.resource.data.get('status', '') == 'Active'
        && request.resource.data.updatedAt == request.time;
    }

    function validMembershipData(academyId, uid) {
      return request.resource.data.keys().hasAll([
          'userId', 'academyId', 'role', 'status', 'source',
          'joinedAt', 'joinedBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'academyId', 'role', 'status', 'source',
          'approvalClaimId', 'joinedAt', 'joinedBy', 'updatedAt'
        ])
        && request.resource.data.userId == uid
        && request.resource.data.academyId == academyId
        && request.resource.data.role in ['ADMIN', 'COACH']
        && request.resource.data.status in [
          'PENDING', 'ACTIVE', 'SUSPENDED', 'LEFT', 'REVOKED'
        ]
        && request.resource.data.source in [
          'CLAIM_APPROVAL',
          'SUPERADMIN_ASSIGNMENT',
          'LEGACY_MIGRATION',
          'INVITE'
        ]
        && (
          (
            request.resource.data.source == 'CLAIM_APPROVAL'
            && exactDocumentId(
              request.resource.data.get('approvalClaimId', '')
            )
          )
          || (
            request.resource.data.source != 'CLAIM_APPROVAL'
            && !request.resource.data.keys().hasAny(['approvalClaimId'])
          )
        );
    }

    function claimRole(claim) {
      return claim.get('type', '') == 'COACH_JOIN'
        ? 'COACH'
        : claim.get('requestedRole', '');
    }

    function isClaimOwner(claim) {
      return isSignedIn() && claim.get('userId', '') == request.auth.uid;
    }

    function isMatchingAcademyAdminForClaim(claim) {
      let inviteCode = claim.get('inviteCode', '');
      let invite = get(
        /databases/$(database)/documents/academy_invites/$(inviteCode)
      ).data;
      let academyId = invite.get('academyId', '');
      return activeInviteMatchesAcademy(inviteCode, academyId)
        && claim.get('requestedAcademyId', academyId) == academyId
        && hasAcademyRole(academyId, ['ADMIN']);
    }

    function validNewClaim(claimId) {
      return request.resource.data.keys().hasAll([
          'type', 'userId', 'requestedRole', 'inviteCode', 'requestedAcademyId',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'type',
          'userId',
          'userEmail',
          'userName',
          'requestedRole',
          'inviteCode',
          'requestedAcademyId',
          'requestedAcademyName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.type == 'ACADEMY_JOIN'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.requestedRole in ['ADMIN', 'COACH']
        && request.resource.data.status == 'PENDING'
        && validInviteCode(request.resource.data.inviteCode)
        && exactDocumentId(request.resource.data.requestedAcademyId)
        && activeInviteMatchesAcademy(
          request.resource.data.inviteCode,
          request.resource.data.requestedAcademyId
        )
        && claimId == request.resource.data.userId
          + '_' + request.resource.data.requestedRole
          + '_' + request.resource.data.inviteCode
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function claimIdentityIsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'approvedAt',
        'approvedBy',
        'approvedAcademyId',
        'approvedRole',
        'rejectedAt',
        'rejectedBy',
        'updatedAt',
        'id'
      ]);
    }

    function approvedClaimMatchesMembership(claimId) {
      let academyId = request.resource.data.get('approvedAcademyId', '');
      let uid = resource.data.get('userId', '');
      let membership = getAfter(
        /databases/$(database)/documents/academies/$(academyId)/members/$(uid)
      ).data;
      return academyId != ''
        && membership.get('userId', '') == uid
        && membership.get('academyId', '') == academyId
        && membership.get('status', '') == 'ACTIVE'
        && membership.get('role', '') == claimRole(resource.data)
        && membership.get('source', '') == 'CLAIM_APPROVAL'
        && membership.get('approvalClaimId', '') == claimId;
    }

    function validClaimApproval(claimId) {
      let inviteCode = resource.data.get('inviteCode', '');
      let invite = get(
        /databases/$(database)/documents/academy_invites/$(inviteCode)
      ).data;
      let academyId = invite.get('academyId', '');
      return request.resource.data.status == 'APPROVED'
        && activeInviteMatchesAcademy(inviteCode, academyId)
        && resource.data.get('requestedAcademyId', academyId) == academyId
        && request.resource.data.get('approvedAcademyId', '') == academyId
        && request.resource.data.get('approvedRole', '') == claimRole(resource.data)
        && request.resource.data.updatedAt == request.time
        && approvedClaimMatchesMembership(claimId)
        && (
          (
            resource.data.status == 'PENDING'
            && request.resource.data.approvedAt == request.time
            && request.resource.data.approvedBy == request.auth.uid
          )
          || (
            resource.data.status == 'APPROVED'
            && request.resource.data.approvedAt == resource.data.approvedAt
            && request.resource.data.approvedBy == resource.data.approvedBy
            && request.resource.data.approvedAcademyId == resource.data.approvedAcademyId
            && request.resource.data.approvedRole == resource.data.approvedRole
          )
        );
    }

    function validClaimRejection() {
      return resource.data.status == 'PENDING'
        && request.resource.data.status == 'REJECTED'
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.rejectedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function claimReviewerMayUpdate() {
      return isSuperAdmin()
        || isMatchingAcademyAdminForClaim(resource.data);
    }

    function claimApprovalReferenceMatches(academyId, uid) {
      let claimId = request.resource.data.get('approvalClaimId', '');
      let claim = getAfter(
        /databases/$(database)/documents/profile_claims/$(claimId)
      ).data;
      return exactDocumentId(claimId)
        && existsAfter(
          /databases/$(database)/documents/profile_claims/$(claimId)
        )
        && claim.get('status', '') == 'APPROVED'
        && claim.get('userId', '') == uid
        && claim.get('approvedAcademyId', '') == academyId
        && claim.get('approvedRole', '') == request.resource.data.role
        && activeInviteMatchesAcademy(
          claim.get('inviteCode', ''),
          academyId
        )
        && claim.get('requestedAcademyId', academyId) == academyId;
    }

    function validMembershipApprovalReference(academyId, uid) {
      return request.resource.data.source != 'CLAIM_APPROVAL'
        || claimApprovalReferenceMatches(academyId, uid);
    }

    function membershipApprovalReferenceIsStable() {
      return (
          resource.data.get('source', '') == request.resource.data.source
          && (
            resource.data.get('approvalClaimId', '')
              == request.resource.data.get('approvalClaimId', '')
            || (
              resource.data.source == 'CLAIM_APPROVAL'
              && resource.data.get('approvalClaimId', '') == ''
            )
          )
        )
        || (
          resource.data.get('source', '') != 'CLAIM_APPROVAL'
          && request.resource.data.source == 'CLAIM_APPROVAL'
        );
    }

    function validAcademyInviteData(inviteCode) {
      return request.resource.data.keys().hasAll([
          'inviteCode', 'academyId', 'status',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'inviteCode', 'academyId', 'status',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && validInviteCode(inviteCode)
        && request.resource.data.inviteCode == inviteCode
        && exactDocumentId(request.resource.data.academyId)
        && exists(
          /databases/$(database)/documents/academies/$(request.resource.data.academyId)
        )
        && request.resource.data.status in ['ACTIVE', 'REVOKED']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validRegistrationLogData(logId, logData, userData) {
      return logId == registrationLogId(request.auth.uid)
        && logData.keys().hasAll([
          'action', 'userId', 'email', 'requestedRole', 'timestamp'
        ])
        && logData.keys().hasOnly([
          'action', 'userId', 'email', 'requestedRole', 'timestamp'
        ])
        && logData.action == 'USER_REGISTERED'
        && logData.userId == request.auth.uid
        && logData.timestamp == request.time
        && logData.email == request.auth.token.get('email', '')
        && logData.email == userData.get('email', '')
        && logData.requestedRole == userData.get('requestedRole', '');
    }

    function validClientRegistrationLog(logId) {
      let uid = request.auth.uid;
      let userPath = /databases/$(database)/documents/users/$(uid);
      return !exists(userPath)
        && existsAfter(userPath)
        && validRegistrationUserData(uid, getAfter(userPath).data)
        && validRegistrationLogData(
          logId,
          request.resource.data,
          getAfter(userPath).data
        );
    }

    match /users/{uid} {
      // Pro Club Membership Discovery V1 — discovery only, never authority.
      match /proClubMemberships/{clubId} {
        allow get, list: if currentUserIsActive()
          && request.auth.uid == uid;

        // Staff discovery pointers may only be born inside the same
        // canonical approval batch that creates proof/member/staff.
        allow create: if isSignedIn()
          && exactDocumentId(uid)
          && exactDocumentId(clubId)
          && request.resource.data.keys().hasAll([
            'schemaVersion',
            'clubId'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion',
            'clubId'
          ])
          && request.resource.data.get('schemaVersion', 0) == 1
          && request.resource.data.get('clubId', '') == clubId
          && freshProClubApprovalProofForUidV1(clubId, uid)
          && existsAfter(
            /databases/$(database)/documents/proClubs/$(clubId)/members/$(uid)
          )
          && getAfter(
            /databases/$(database)/documents/proClubs/$(clubId)/members/$(uid)
          ).data.get('authorizationRole', '') == 'MEMBER'
          && getAfter(
            /databases/$(database)/documents/proClubs/$(clubId)/members/$(uid)
          ).data.get('status', '') == 'ACTIVE'
          && existsAfter(
            /databases/$(database)/documents/proClubs/$(clubId)/staff/$(uid)
          )
          && getAfter(
            /databases/$(database)/documents/proClubs/$(clubId)/staff/$(uid)
          ).data.get('status', '') == 'ACTIVE';

        allow update, delete: if false;
      }
      allow read: if isOwnUserDocument(uid) || isSuperAdmin();
      allow create: if isOwnUserDocument(uid)
        && hasNoStoredDocumentId()
        && hasCanonicalUserUid(uid)
        && validRegistrationUser(uid);
      allow update: if hasNoStoredDocumentId()
        && hasCanonicalUserUid(uid)
        && (
          isSuperAdmin()
          || (
            isOwnUserDocument(uid)
            && (
              safeOwnerProfileUpdate()
              || userPointerUpdateMatchesActiveMembership(uid)
            )
          )
        );
      allow delete: if false;
    }

    match /academy_invites/{inviteCode} {
      allow get: if isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.get('inviteCode', '') == inviteCode
          && resource.data.get('status', '') == 'ACTIVE'
          && validInviteCode(inviteCode)
        );
      allow list: if false;
      allow create: if isSuperAdmin()
        && hasNoStoredDocumentId()
        && validAcademyInviteData(inviteCode)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSuperAdmin()
        && hasNoStoredDocumentId()
        && validAcademyInviteData(inviteCode)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isSuperAdmin();
    }

    match /profile_claims/{claimId} {
      allow create: if isSignedIn()
        && hasNoStoredDocumentId()
        && validNewClaim(claimId);
      allow read: if isSignedIn()
        && (
          isClaimOwner(resource.data)
          || isMatchingAcademyAdminForClaim(resource.data)
          || isSuperAdmin()
        );
      allow update: if isSignedIn()
        && hasNoStoredDocumentId()
        && claimIdentityIsUnchanged()
        && claimReviewerMayUpdate()
        && (validClaimApproval(claimId) || validClaimRejection());
      allow delete: if false;
    }

    match /academies/{academyId} {
      allow read: if isSuperAdmin() || isActiveAcademyMember(academyId);
      allow create: if isSuperAdmin() && hasNoStoredDocumentId();
      allow update: if hasNoStoredDocumentId()
        && (isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']));
      allow delete: if isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']);

      match /members/{uid} {
        allow read: if isSuperAdmin()
          || isOwnUserDocument(uid)
          || hasAcademyRole(academyId, ['ADMIN']);
        allow create: if validMembershipData(academyId, uid)
          && hasNoStoredDocumentId()
          && validMembershipApprovalReference(academyId, uid)
          && (isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']))
          && request.resource.data.joinedBy == request.auth.uid
          && request.resource.data.joinedAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if validMembershipData(academyId, uid)
          && hasNoStoredDocumentId()
          && membershipApprovalReferenceIsStable()
          && (
            (
              resource.data.get('source', '') == request.resource.data.source
              && resource.data.get('approvalClaimId', '')
                == request.resource.data.get('approvalClaimId', '')
            )
            || validMembershipApprovalReference(academyId, uid)
          )
          && (isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']))
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.joinedBy == resource.data.joinedBy
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /nonstaffUsers/{uid} {
        allow read, write: if false;

        match /playerAssociations/{playerId} {
          allow get: if validNonStaffAssociationData(
              resource.data,
              academyId,
              uid,
              playerId
            )
            && (
              isSuperAdmin()
              || isActiveAcademyMember(academyId)
              || (
                isSignedIn()
                && request.auth.uid == uid
                && resource.data.userId == request.auth.uid
              )
            );
          allow list: if isSuperAdmin()
            || isActiveAcademyMember(academyId)
            || (
              isSignedIn()
              && resource.data.userId == request.auth.uid
            );
          allow create: if validNonStaffAssociationData(
              request.resource.data,
              academyId,
              uid,
              playerId
            )
            && nonStaffAssociationTargetsExist(
              academyId,
              uid,
              playerId,
              request.resource.data.role
            )
            && (
              isSuperAdmin()
              || hasAcademyRole(academyId, ['ADMIN'])
            );
          allow update: if validNonStaffAssociationData(
              request.resource.data,
              academyId,
              uid,
              playerId
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status'
            ])
            && (
              isSuperAdmin()
              || hasAcademyRole(academyId, ['ADMIN'])
            );
          allow delete: if isSuperAdmin()
            || hasAcademyRole(academyId, ['ADMIN']);
        }
      }

      // Academy Fitness Coach Specialty V1 — functional football assignment
      // separated from canonical Academy membership authority.
      match /staffSpecialties/{uid} {
        allow get: if isSuperAdmin()
          || hasAcademyRole(academyId, ['ADMIN'])
          || (
            isOwnUserDocument(uid)
            && isActiveAcademyMember(academyId)
          );
        allow list: if isSuperAdmin()
          || hasAcademyRole(academyId, ['ADMIN']);
        allow create: if validAcademyFitnessCoachSpecialtyCreateV1(
          academyId,
          uid
        );
        allow update: if validAcademyFitnessCoachSpecialtyUpdateV1(
          academyId,
          uid
        );
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      // Academy Fitness Results V1 — canonical append-only persistence path.
      match /fitnessResults/{resultId} {
        allow get, list: if tenantMemberCanRead(academyId);

        allow create: if validAcademyFitnessResultCreateV1(
          academyId,
          resultId
        );

        allow update, delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }
      match /coaches/{coachProfileId} {
        allow read: if isSuperAdmin() || isActiveAcademyMember(academyId);
        allow create, update: if hasNoStoredDocumentId()
          && (
            isSuperAdmin()
            || hasAcademyRole(academyId, ['ADMIN'])
          );
        allow delete: if isSuperAdmin()
          || hasAcademyRole(academyId, ['ADMIN']);
      }

      match /players/{playerId} {
        allow get: if tenantMemberCanRead(academyId)
          || canReadAssociatedPlayer(academyId, playerId);
        allow list: if tenantMemberCanRead(academyId);
        allow create, update: if tenantFootballCanWrite(academyId)
          && hasNoStoredDocumentId();
        allow delete: if tenantFootballCanWrite(academyId);

        match /{playerCollection}/{document=**} {
          allow read: if tenantMemberCanRead(academyId);
          allow write: if tenantFootballCanWrite(academyId);
        }
      }

      match /player_evaluations/{evaluationId} {
        allow get, list: if tenantMemberCanRead(academyId);
        allow create, update, delete: if false;
      }

      match /matches/{matchId} {
        allow read: if tenantMemberCanRead(academyId);

        allow create: if tenantFootballCanWrite(academyId)
          && validMatchCreate();

        allow update: if tenantFootballCanWrite(academyId)
          && validMatchUpdate();

        allow delete: if false;

        match /roster/{playerId} {
          allow read: if tenantMemberCanRead(academyId);

          allow create: if tenantFootballCanWrite(academyId)
            && matchRosterIsMutable(academyId, matchId)
            && validMatchRosterCreate(
              academyId,
              playerId
            );

          allow update: if tenantFootballCanWrite(academyId)
            && matchRosterIsMutable(academyId, matchId)
            && validMatchRosterUpdate(
              academyId,
              playerId
            );

          allow delete: if tenantFootballCanWrite(academyId)
            && matchRosterIsMutable(academyId, matchId);
        }

        match /{document=**} {
          allow read, write: if false;
        }
      }
    }

    // Firestore collection-group queries require an explicit recursive match.
    // The userId equality is query-provable; the client then validates the exact
    // Academy/UID/Player path and complete schema before resolving any access.
    match /{associationPath=**}/playerAssociations/{playerId} {
      allow list: if isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    match /settings/{document=**} {
      allow read, write: if false;
    }

    match /coaches/{document=**} {
      allow read, write: if false;
    }

    match /logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if hasNoStoredDocumentId()
        && (
          isSuperAdmin()
          || (isSignedIn() && validClientRegistrationLog(logId))
        );
      allow update, delete: if false;
    }

    match /logs/{parent}/{document=**} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() && hasNoStoredDocumentId();
      allow update, delete: if false;
    }

    match /players/{document=**} {
      allow read, write: if false;
    }

    // Lifelong Player Identity Foundation V1.
    //
    // Identity and FUTID registry records are created only as one atomic pair.
    // Neither document may be updated or deleted in V1.
    match /playerIdentities/{playerKey} {
      allow create: if validPlayerIdentityCreateData(playerKey);
      allow read, update, delete: if false;
    }

    match /futIdRegistry/{futId} {
      allow create: if validFutIdRegistryCreateData(futId);
      allow read, update, delete: if false;
    }
    match /drills/{drillId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && hasNoStoredDocumentId()
        && exactDocumentId(request.resource.data.get('created_by', ''))
        && (
          request.resource.data.get('created_by', '') == request.auth.uid
          || (
            isSuperAdmin()
            && userExists(request.resource.data.get('created_by', ''))
            && get(
              /databases/$(database)/documents/users/$(request.resource.data.get('created_by', ''))
            ).data.get('status', '') in ['Active', 'ACTIVE']
          )
        );

      allow update: if isSignedIn()
        && hasNoStoredDocumentId()
        && request.resource.data.get('created_by', '') ==
           resource.data.get('created_by', '')
        && (
          resource.data.get('created_by', '') == request.auth.uid
          || isSuperAdmin()
        );

      allow delete: if isSignedIn()
        && (
          resource.data.get('created_by', '') == request.auth.uid
          || isSuperAdmin()
        );

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Pro Club onboarding write helpers โ€” Slice 2B.
    //
    // Runtime authority remains the canonical active Membership document.
    // Invite, claim, and approval-proof records are onboarding evidence only.
    function validProClubInviteCodeV1(inviteCode) {
      return inviteCode is string
        && inviteCode.size() >= 31
        && inviteCode.size() <= 55
        && inviteCode.matches('^FUT-PC-[A-Z0-9]+$');
    }

    function validProClubStaffRoleV1(role) {
      return role in [
        'TECHNICAL_DIRECTOR',
        'MANAGER',
        'HEAD_COACH',
        'ASSISTANT_COACH',
        'GK_COACH',
        'FITNESS_COACH',
        'ANALYST',
        'PHYSIO',
        'TEAM_MANAGER',
        'STAFF'
      ];
    }

    function validProClubDocumentForAuthorityV1(data) {
      return data.keys().hasAll(['name', 'level', 'status'])
        && data.keys().hasOnly([
          'name',
          'shortName',
          'level',
          'status',
          'country',
          'logoUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.level in ['T1', 'T2', 'T3']
        && data.status in ['ACTIVE', 'INACTIVE'];
    }

    function validProClubMembershipDataV1(data) {
      return data.keys().hasAll(['authorizationRole', 'status'])
        && data.keys().hasOnly(['authorizationRole', 'status'])
        && data.authorizationRole in ['OWNER', 'ADMIN', 'MEMBER']
        && data.status in ['ACTIVE', 'INACTIVE', 'LEFT', 'REVOKED'];
    }

    function validProClubStaffDataV1(data) {
      return data.keys().hasAll(['staffRole', 'status'])
        && data.keys().hasOnly(['staffRole', 'status'])
        && validProClubStaffRoleV1(data.staffRole)
        && data.status in ['ACTIVE', 'INACTIVE', 'LEFT'];
    }

    function isActiveProClubReviewerV1(clubId) {
      return isSignedIn()
        && exactDocumentId(clubId)
        && currentUserIsActive()
        && proClubReviewerDocumentsAreActiveV1(clubId);
    }

    function proClubReviewerDocumentsAreActiveV1(clubId) {
      let club = get(
        /databases/$(database)/documents/proClubs/$(clubId)
      ).data;
      let reviewer = get(
        /databases/$(database)/documents/proClubs/$(clubId)/members/$(request.auth.uid)
      ).data;

      return club.keys().hasOnly([
          'name',
          'shortName',
          'level',
          'status',
          'country',
          'logoUrl',
          'createdAt',
          'updatedAt'
        ])
        && club.get('name', '') is string
        && club.get('name', '').size() > 0
        && club.get('level', '') in ['T1', 'T2', 'T3']
        && club.get('status', '') == 'ACTIVE'
        && reviewer.keys().hasOnly([
          'authorizationRole',
          'status'
        ])
        && reviewer.get('status', '') == 'ACTIVE'
        && reviewer.get('authorizationRole', '')
          in ['OWNER', 'ADMIN'];
    }

    // Pro Club SuperAdmin Onboarding Control V1 — platform control-plane helpers.
    // SuperAdmin authority is explicit and never fabricated as tenant membership.
    function proClubDocumentIsActiveForOnboardingControlV1(clubId) {
      let clubPath =
        /databases/$(database)/documents/proClubs/$(clubId);
      let club = get(clubPath).data;

      return exactDocumentId(clubId)
        && exists(clubPath)
        && validProClubDocumentForAuthorityV1(club)
        && club.get('status', '') == 'ACTIVE';
    }

    function currentUserHasSuperAdminRoleV1() {
      return isSignedIn()
        && userExists(request.auth.uid)
        && currentUserData().get('role', '') == 'SUPERADMIN';
    }

    function isProClubOnboardingControlActorV1(clubId) {
      return currentUserHasSuperAdminRoleV1()
        ? (
          isSuperAdmin()
          && proClubDocumentIsActiveForOnboardingControlV1(clubId)
        )
        : isActiveProClubReviewerV1(clubId);
    }

    function proClubSuperAdminInviteTargetIsEligibleV1(uid) {
      let userPath =
        /databases/$(database)/documents/users/$(uid);
      let user = get(userPath).data;

      return exactDocumentId(uid)
        && uid != request.auth.uid
        && exists(userPath)
        && user.get('status', '') in ['Active', 'ACTIVE']
        && user.get('role', '') != 'SUPERADMIN';
    }

    function proClubOnboardingControlAuditMatchesV1(
      data,
      actionId,
      clubId,
      uid,
      inviteCode,
      claimId,
      staffRole
    ) {
      return data.keys().hasAll([
          'schemaVersion',
          'actionId',
          'actionType',
          'actorUid',
          'clubId',
          'targetUid',
          'inviteCode',
          'claimId',
          'staffRole',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'actionId',
          'actionType',
          'actorUid',
          'clubId',
          'targetUid',
          'inviteCode',
          'claimId',
          'staffRole',
          'createdAt'
        ])
        && data.get('schemaVersion', 0) == 1
        && data.get('actionId', '') == actionId
        && data.get('actorUid', '') == request.auth.uid
        && data.get('clubId', '') == clubId
        && data.get('targetUid', '') == uid
        && data.get('inviteCode', '') == inviteCode
        && data.get('claimId', '__missing__') == claimId
        && data.get('staffRole', '') == staffRole
        && data.get('createdAt', null) == request.time;
    }

    function matchingProClubOnboardingControlAuditAfterV1(
      actionId,
      actionType,
      clubId,
      uid,
      inviteCode,
      claimId,
      staffRole
    ) {
      let auditPath =
        /databases/$(database)/documents/proClubOnboardingControlAudits/$(actionId);
      let audit = getAfter(auditPath).data;

      return existsAfter(auditPath)
        && audit.get('actionType', '') == actionType
        && proClubOnboardingControlAuditMatchesV1(
          audit,
          actionId,
          clubId,
          uid,
          inviteCode,
          claimId,
          staffRole
        );
    }

    function validProClubOnboardingControlAuditCreateV1(actionId) {
      let data = request.resource.data;
      let clubId = data.get('clubId', '');
      let uid = data.get('targetUid', '');
      let inviteCode = data.get('inviteCode', '');
      let claimId = data.get('claimId', null);
      let staffRole = data.get('staffRole', '');
      let invitePath =
        /databases/$(database)/documents/proClubInvites/$(inviteCode);
      let claimPath =
        /databases/$(database)/documents/proClubs/$(clubId)/onboardingClaims/$(claimId);
      let proofPath =
        /databases/$(database)/documents/proClubs/$(clubId)/onboardingApprovals/$(uid);

      return isSuperAdmin()
        && proClubDocumentIsActiveForOnboardingControlV1(clubId)
        && validProClubStaffRoleV1(staffRole)
        && data.get('actionId', '') == actionId
        && (
          (
            data.get('actionType', '') == 'INVITE_ISSUED'
            && actionId == 'INVITE-' + inviteCode
            && claimId == null
            && proClubOnboardingControlAuditMatchesV1(
              data,
              actionId,
              clubId,
              uid,
              inviteCode,
              null,
              staffRole
            )
            && existsAfter(invitePath)
            && getAfter(invitePath).data.get('status', '') == 'ACTIVE'
            && getAfter(invitePath).data.get('clubId', '') == clubId
            && getAfter(invitePath).data.get('targetUid', '') == uid
            && getAfter(invitePath).data.get('staffRole', '') == staffRole
            && getAfter(invitePath).data.get('createdBy', '') == request.auth.uid
          )
          || (
            data.get('actionType', '') == 'CLAIM_APPROVED'
            && exactDocumentId(claimId)
            && actionId == 'APPROVE-' + claimId
            && proClubOnboardingControlAuditMatchesV1(
              data,
              actionId,
              clubId,
              uid,
              inviteCode,
              claimId,
              staffRole
            )
            && existsAfter(proofPath)
            && getAfter(proofPath).data.get('status', '') == 'APPROVED'
            && getAfter(proofPath).data.get('claimId', '') == claimId
            && getAfter(proofPath).data.get('inviteCode', '') == inviteCode
            && getAfter(proofPath).data.get('staffRole', '') == staffRole
            && getAfter(proofPath).data.get('approvedBy', '') == request.auth.uid
            && getAfter(proofPath).data.get('approvedAt', null) == request.time
            && validProClubApprovalEvidenceAfterV1(
              clubId,
              uid,
              claimId,
              inviteCode,
              staffRole
            )
          )
          || (
            data.get('actionType', '') == 'CLAIM_REJECTED'
            && exactDocumentId(claimId)
            && actionId == 'REJECT-' + claimId
            && proClubOnboardingControlAuditMatchesV1(
              data,
              actionId,
              clubId,
              uid,
              inviteCode,
              claimId,
              staffRole
            )
            && existsAfter(claimPath)
            && getAfter(claimPath).data.get('status', '') == 'REJECTED'
            && getAfter(claimPath).data.get('userId', '') == uid
            && existsAfter(invitePath)
            && getAfter(invitePath).data.get('status', '') == 'REVOKED'
            && !existsAfter(
              /databases/$(database)/documents/proClubs/$(clubId)/members/$(uid)
            )
            && !existsAfter(
              /databases/$(database)/documents/proClubs/$(clubId)/staff/$(uid)
            )
            && !existsAfter(proofPath)
          )
        );
    }

    function validProClubInviteCoreV1(data, inviteCode) {
      return data.get('schemaVersion', 0) == 1
        && data.get('inviteCode', '') == inviteCode
        && validProClubInviteCodeV1(inviteCode)
        && exactDocumentId(data.get('clubId', ''))
        && exactDocumentId(data.get('targetUid', ''))
        && data.get('membershipAuthorizationRole', '') == 'MEMBER'
        && validProClubStaffRoleV1(data.get('staffRole', ''))
        && data.get('createdAt', null) is timestamp
        && exactDocumentId(data.get('createdBy', ''))
        && data.get('expiresAt', null) is timestamp
        && data.get('updatedAt', null) is timestamp
        && exactDocumentId(data.get('updatedBy', ''));
