        return proClubMatchFootballAuthorityV1(clubId)
          && proClubGameModelKeysV1(data)
          && data.get('schemaVersion', 0) == 1
          && previous.get('schemaVersion', 0) == 1
          && proClubGameModelPhasesValidV1(data.get('phases', {}))
          && data.get('revision', 0) == previous.get('revision', 0) + 1
          && data.get('createdAt', null) == previous.get('createdAt', null)
          && data.get('createdBy', '') == previous.get('createdBy', '')
          && data.get('createdByRole', '') == previous.get('createdByRole', '')
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid
          && data.get('updatedByRole', '') == actorRole;
