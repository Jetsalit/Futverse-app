    function proClubInviteIdentityUnchangedV1() {
      return request.resource.data.get('schemaVersion', 0)
          == resource.data.get('schemaVersion', 0)
        && request.resource.data.get('inviteCode', '')
          == resource.data.get('inviteCode', '')
        && request.resource.data.get('clubId', '')
          == resource.data.get('clubId', '')
        && request.resource.data.get('targetUid', '')
          == resource.data.get('targetUid', '')
        && request.resource.data.get('membershipAuthorizationRole', '')
