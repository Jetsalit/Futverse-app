          existsAfter(claimPath)
          && validProClubRejectedClaimAfterV1(
            clubId,
            uid,
            claimId,
            inviteCode,
            staffRole
          )
        );
    }

    function validProClubRejectedClaimAfterV1(
      clubId,
      uid,
      claimId,
      inviteCode,
      staffRole
    ) {
      let claim = getAfter(
        /databases/$(database)/documents/proClubs/$(clubId)/onboardingClaims/$(claimId)
      ).data;

      return claim.get('status', '') == 'REJECTED'
        && claim.get('userId', '') == uid
        && claim.get('clubId', '') == clubId
        && claim.get('inviteCode', '') == inviteCode
        && claim.get('membershipAuthorizationRole', '') == 'MEMBER'
        && claim.get('staffRole', '') == staffRole
        && claim.get('rejectedAt', null) == request.time
        && claim.get('rejectedBy', '') == request.auth.uid
        && claim.get('updatedAt', null) == request.time;
    }
    match /proClubInvites/{inviteCode} {
      allow get: if isSignedIn()
        && (
          (
            // Exact-code capability lookup exposes only the closed V1 schema.
            // Expiry restricts claim/approval writes, not status inspection.
            validProClubActiveInviteDataV1(resource.data, inviteCode)
            || validProClubRevokedInviteDataV1(resource.data, inviteCode)
            || validProClubConsumedInviteDataV1(resource.data, inviteCode)
          )
          || isActiveProClubReviewerV1(
            resource.data.get('clubId', '')
          )
        );
      allow list: if false;
      allow create: if validProClubInviteCreateV1(inviteCode);
      allow update: if resource != null
        && (
          request.resource.data.get('status', '') == 'CONSUMED'
            ? validProClubInviteConsumptionV1(inviteCode)
            : (
              request.resource.data.get('status', '') == 'REVOKED'
              && validProClubInviteRevocationV1(inviteCode)
            )
        );
      allow delete: if false;
    }

    // Pro Club Firestore Rules V1 + Onboarding Slice 2B.
    //
    // Relationship evidence remains distinct from tenant authority. Exact own
    // Membership/Staff reads are preserved for runtime classification. Client
    // writes are opened only for the reviewed invite/claim approval lifecycle.
    match /proClubs/{clubId} {
      allow get: if isSignedIn()
        && exists(
          /databases/$(database)/documents/proClubs/$(clubId)/members/$(request.auth.uid)
        );

      allow list, create, update, delete: if false;

      match /members/{uid} {
        allow get: if isSignedIn()
          && request.auth.uid == uid;
        allow list: if false;
        allow create: if validProClubMembershipCreateV1(clubId, uid);
        allow update, delete: if false;
      }

      match /staff/{uid} {
        allow get: if isSignedIn()
          && request.auth.uid == uid;
        allow list: if false;
        allow create: if validProClubStaffCreateV1(clubId, uid);
        allow update, delete: if false;
      }

      match /onboardingClaims/{claimId} {
        allow get: if isSignedIn()
          && (
            resource.data.get('userId', '') == request.auth.uid
            || isActiveProClubReviewerV1(clubId)
          );
        // Queries must constrain both fields; Rules do not filter results.
        // Authority comes from this exact tenant path, never users.role.
        allow list: if isActiveProClubReviewerV1(clubId)
          && resource.data.clubId == clubId
          && resource.data.status == 'PENDING';
        allow create: if validProClubClaimCreateV1(clubId, claimId);
        allow update: if resource != null
          && (
            request.resource.data.get('status', '') == 'APPROVED'
              ? validProClubClaimApprovalV1(clubId, claimId)
              : (
                request.resource.data.get('status', '') == 'REJECTED'
                && validProClubClaimRejectionV1(clubId, claimId)
              )
          );
        allow delete: if false;
      }

      match /onboardingApprovals/{uid} {
        allow get: if isSignedIn()
          && (
            request.auth.uid == uid
            || isActiveProClubReviewerV1(clubId)
          );
        allow list: if false;
        allow create: if validProClubApprovalProofCreateV1(clubId, uid);
        allow update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /proPlayers/{proPlayerId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && hasNoStoredDocumentId();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /scoutPlayers/{scoutPlayerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && hasNoStoredDocumentId()
        && request.resource.data.get('submittedBy', '') == request.auth.uid
        && (
          isAdmin()
          || (
            request.resource.data.get('status', '') == 'Pending'
            && request.resource.data.get('grade', '') == 'C'
            && request.resource.data.get('stars', 0) == 3
          )
        );
      allow update: if isAdmin()
        && hasNoStoredDocumentId()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'submittedBy'
        ]);
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
