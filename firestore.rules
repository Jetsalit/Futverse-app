    // Pro Club Squad Roster V1 — Spark direct Firestore boundary.
    function proClubSquadRosterValidPositionV1(value) {
      return value in [
        'GK', 'LB', 'LWB', 'CB', 'RB', 'RWB', 'DM', 'LM',
        'CM', 'RM', 'AM', 'LW', 'RW', 'CF', 'ST'
      ];
    }

    function proClubSquadRosterValidPrimaryPositionV1(value) {
      return value == null
        || proClubSquadRosterValidPositionV1(value);
    }

    function proClubSquadRosterNormalizedTextV1(value, maxLength, allowEmpty) {
      return value is string
        && value.size() <= maxLength
        && value.trim() == value
        && (allowEmpty || value.size() > 0);
    }

    function proClubSquadRosterValidAdditionalPositionsV1(primary, positions) {
      return positions is list
        && (
          primary == null
            ? positions.size() == 0
            : proClubSquadRosterValidAdditionalPositionsListV1(primary, positions)
        );
    }

    function proClubSquadRosterValidAdditionalPositionsListV1(primary, positions) {
      let count = positions.size();
      return count <= 3
        && (count < 1 || (
          proClubSquadRosterValidPositionV1(positions[0])
          && positions[0] != primary
        ))
        && (count < 2 || (
          proClubSquadRosterValidPositionV1(positions[1])
          && positions[1] != primary
          && positions[1] != positions[0]
        ))
        && (count < 3 || (
          proClubSquadRosterValidPositionV1(positions[2])
          && positions[2] != primary
          && positions[2] != positions[0]
          && positions[2] != positions[1]
        ));
    }

    function proClubSquadRosterClubIsActiveV1(clubId) {
      let clubPath = /databases/$(database)/documents/proClubs/$(clubId);
      let club = get(clubPath).data;
      return exactDocumentId(clubId)
        && exists(clubPath)
        && validProClubDocumentForAuthorityV1(club)
        && club.get('status', '') == 'ACTIVE';
    }

    function proClubSquadRosterActiveStaffV1(clubId) {
      let membershipPath = /databases/$(database)/documents/proClubs/$(clubId)/members/$(request.auth.uid);
      let staffPath = /databases/$(database)/documents/proClubs/$(clubId)/staff/$(request.auth.uid);
      let membership = get(membershipPath).data;
      let staff = get(staffPath).data;
      return currentUserIsActive()
        && proClubSquadRosterClubIsActiveV1(clubId)
        && exists(membershipPath)
        && exists(staffPath)
        && validProClubMembershipDataV1(membership)
        && validProClubStaffDataV1(staff)
        && membership.get('status', '') == 'ACTIVE'
        && staff.get('status', '') == 'ACTIVE';
    }

    function proClubSquadRosterActiveHeadCoachV1(clubId) {
      let staffPath = /databases/$(database)/documents/proClubs/$(clubId)/staff/$(request.auth.uid);
      return proClubSquadRosterActiveStaffV1(clubId)
        && get(staffPath).data.get('staffRole', '') == 'HEAD_COACH';
    }

    function proClubSquadRosterFutIdCompatibleV1(playerKey, futId) {
      return futId == null
        || proClubSquadRosterNonNullFutIdCompatibleV1(playerKey, futId);
    }

    function proClubSquadRosterNonNullFutIdCompatibleV1(playerKey, futId) {
      let registryPath = /databases/$(database)/documents/futIdRegistry/$(futId);
      return validIssuedFutIdV1(futId)
        && exists(registryPath)
        && get(registryPath).data.get('schemaVersion', 0) == 1
        && get(registryPath).data.get('futId', '') == futId
        && get(registryPath).data.get('playerKey', '') == playerKey;
    }

    function proClubSquadRosterHasCanonicalKeysV1(data) {
      return data.keys().hasAll([
          'schemaVersion', 'futId', 'firstName', 'lastName', 'position',
          'additionalPositions', 'jerseyNumber', 'squadLabel', 'status',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'futId', 'firstName', 'lastName', 'position',
          'additionalPositions', 'jerseyNumber', 'squadLabel', 'status',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ]);
    }

    function proClubSquadRosterValidDataV1(playerKey, data) {
      return validPlayerIdentityKeyV1(playerKey)
        && proClubSquadRosterHasCanonicalKeysV1(data)
        && data.get('schemaVersion', 0) == 1
        && proClubSquadRosterFutIdCompatibleV1(playerKey, data.get('futId', null))
        && proClubSquadRosterNormalizedTextV1(data.get('firstName', ''), 80, false)
        && proClubSquadRosterNormalizedTextV1(data.get('lastName', ''), 80, true)
        && proClubSquadRosterValidPrimaryPositionV1(data.get('position', null))
        && proClubSquadRosterValidAdditionalPositionsV1(
          data.get('position', null),
          data.get('additionalPositions', [])
        )
        && data.get('jerseyNumber', -1) is int
        && data.get('jerseyNumber', -1) >= 0
        && data.get('jerseyNumber', -1) <= 99
        && proClubSquadRosterNormalizedTextV1(data.get('squadLabel', ''), 80, false)
        && data.get('status', '') in ['ACTIVE', 'INACTIVE', 'RELEASED']
        && data.get('createdAt', null) is timestamp
        && exactDocumentId(data.get('createdBy', ''))
        && data.get('updatedAt', null) is timestamp
        && exactDocumentId(data.get('updatedBy', ''));
    }

    function proClubSquadRosterValidCreateV1(clubId, playerKey) {
      let data = request.resource.data;
      return proClubSquadRosterActiveHeadCoachV1(clubId)
        && proClubSquadRosterValidDataV1(playerKey, data)
        && data.get('status', '') == 'ACTIVE'
        && data.get('createdAt', null) == request.time
        && data.get('updatedAt', null) == request.time
        && data.get('createdBy', '') == request.auth.uid
        && data.get('updatedBy', '') == request.auth.uid;
    }

    function proClubSquadRosterValidStatusTransitionV1(fromStatus, toStatus) {
      return (
          fromStatus == 'ACTIVE'
          && toStatus in ['ACTIVE', 'INACTIVE', 'RELEASED']
        )
        || (
          fromStatus == 'INACTIVE'
          && toStatus in ['INACTIVE', 'ACTIVE', 'RELEASED']
        )
        || (fromStatus == 'RELEASED' && toStatus == 'RELEASED');
    }

    function proClubSquadRosterValidFutIdTransitionV1(previousFutId, nextFutId) {
      return previousFutId == null
        ? (nextFutId == null || validIssuedFutIdV1(nextFutId))
        : nextFutId == previousFutId;
    }

    function proClubSquadRosterValidUpdateV1(clubId, playerKey) {
      let data = request.resource.data;
      let previous = resource.data;
      return proClubSquadRosterActiveHeadCoachV1(clubId)
        && validPlayerIdentityKeyV1(playerKey)
        && proClubSquadRosterHasCanonicalKeysV1(previous)
        && previous.get('schemaVersion', 0) == 1
        && proClubSquadRosterValidDataV1(playerKey, data)
        && proClubSquadRosterValidStatusTransitionV1(
          previous.get('status', ''),
          data.get('status', '')
        )
        && proClubSquadRosterValidFutIdTransitionV1(
          previous.get('futId', null),
          data.get('futId', null)
        )
        && data.get('createdAt', null) == previous.get('createdAt', null)
        && data.get('createdBy', '') == previous.get('createdBy', '')
        && data.get('updatedAt', null) == request.time
        && data.get('updatedBy', '') == request.auth.uid;
    }

    // Pro Club Player Photo V1 — compact Firestore Data URL, no Storage bucket.
    function proClubPlayerPhotoHasCanonicalKeysV1(data) {
      return data.keys().hasAll([
          'schemaVersion', 'dataUrl', 'mimeType', 'width', 'height', 'byteSize',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'dataUrl', 'mimeType', 'width', 'height', 'byteSize',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ]);
    }

    function proClubPlayerPhotoValidDataV1(clubId, playerKey, data) {
      let playerPath =
        /databases/$(database)/documents/proClubs/$(clubId)/players/$(playerKey);
      return validPlayerIdentityKeyV1(playerKey)
        && exists(playerPath)
        && proClubPlayerPhotoHasCanonicalKeysV1(data)
        && data.get('schemaVersion', 0) == 1
        && data.get('mimeType', '') == 'image/webp'
        && data.get('dataUrl', '') is string
        && data.get('dataUrl', '').size() > 23
        && data.get('dataUrl', '').size() <= 90000
        && data.get('dataUrl', '').matches('^data:image/webp;base64,.*$')
        && data.get('width', 0) is int
        && data.get('height', 0) is int
        && data.get('width', 0) >= 1
        && data.get('height', 0) >= 1
        && data.get('width', 0) <= 256
        && data.get('height', 0) <= 256
        && data.get('byteSize', 0) is int
        && data.get('byteSize', 0) >= 1
        && data.get('byteSize', 0) <= 61440
        && data.get('createdAt', null) is timestamp
        && exactDocumentId(data.get('createdBy', ''))
        && data.get('updatedAt', null) is timestamp
        && exactDocumentId(data.get('updatedBy', ''));
    }

    function proClubPlayerPhotoValidCreateV1(clubId, playerKey) {
      let data = request.resource.data;
      return proClubSquadRosterActiveHeadCoachV1(clubId)
        && proClubPlayerPhotoValidDataV1(clubId, playerKey, data)
        && data.get('createdAt', null) == request.time
        && data.get('updatedAt', null) == request.time
        && data.get('createdBy', '') == request.auth.uid
        && data.get('updatedBy', '') == request.auth.uid;
    }

    function proClubPlayerPhotoValidUpdateV1(clubId, playerKey) {
      let data = request.resource.data;
      let previous = resource.data;
      return proClubSquadRosterActiveHeadCoachV1(clubId)
        && proClubPlayerPhotoValidDataV1(clubId, playerKey, data)
        && proClubPlayerPhotoHasCanonicalKeysV1(previous)
        && previous.get('schemaVersion', 0) == 1
        && data.get('createdAt', null) == previous.get('createdAt', null)
        && data.get('createdBy', '') == previous.get('createdBy', '')
        && data.get('updatedAt', null) == request.time
        && data.get('updatedBy', '') == request.auth.uid;
    }

    // Pro Club Weekly Training V1 — root Firestore Rules integration.
//
// This intentionally opens only the reviewed DRAFT persistence surface.
// Lifecycle transitions, deletes, Technical Director co-author writes and
// unrelated Pro Club child paths remain fail-closed.
function proClubWeeklyTrainingActiveMemberV1(clubId, uid) {
  let membershipPath =
    /databases/$(database)/documents/proClubs/$(clubId)/members/$(uid);
  return exists(membershipPath)
    && get(membershipPath).data.get('status', '') == 'ACTIVE';
}

function proClubWeeklyTrainingActiveStaffV1(clubId, uid) {
  let staffPath =
    /databases/$(database)/documents/proClubs/$(clubId)/staff/$(uid);
  return exists(staffPath)
    && get(staffPath).data.get('status', '') == 'ACTIVE';
}

function proClubWeeklyTrainingActiveHeadCoachV1(clubId, uid) {
  let membershipPath =
    /databases/$(database)/documents/proClubs/$(clubId)/members/$(uid);
  let staffPath =
    /databases/$(database)/documents/proClubs/$(clubId)/staff/$(uid);
  let membership = get(membershipPath).data;
  let staff = get(staffPath).data;

  return currentUserIsActive()
    && exists(membershipPath)
    && exists(staffPath)
    && membership.get('status', '') == 'ACTIVE'
    && staff.get('status', '') == 'ACTIVE'
    && staff.get('staffRole', '') == 'HEAD_COACH';
}

function proClubWeeklyTrainingCurrentAuthorityIsValidV1(clubId) {
  let authorityPath =
    /databases/$(database)/documents/proClubs/$(clubId)/technicalGovernance/current;
  let authority = get(authorityPath).data;
  let authorityUid = authority.get('authorityUid', '');
  let membershipPath =
    /databases/$(database)/documents/proClubs/$(clubId)/members/$(authorityUid);
  let staffPath =
    /databases/$(database)/documents/proClubs/$(clubId)/staff/$(authorityUid);
  let membership = get(membershipPath).data;
  let staff = get(staffPath).data;

  return exists(authorityPath)
    && authority.get('schemaVersion', 0) == 1
    && authority.get('status', '') == 'ACTIVE'
    && exactDocumentId(authorityUid)
    && authority.get('authorityRole', '')
      in ['TECHNICAL_DIRECTOR', 'HEAD_COACH']
    && exists(membershipPath)
    && exists(staffPath)
    && membership.get('status', '') == 'ACTIVE'
    && staff.get('status', '') == 'ACTIVE'
    && staff.get('staffRole', '')
      == authority.get('authorityRole', '');
}

function proClubWeeklyTrainingValidAuditCreateV1(data) {
  return data.get('createdBy', '') == request.auth.uid
    && data.get('updatedBy', '') == request.auth.uid
    && data.get('createdAt', null) == request.time
    && data.get('updatedAt', null) == request.time;
}

function proClubWeeklyTrainingValidAuditUpdateV1(data, previous) {
  return data.get('createdBy', '') == previous.get('createdBy', '')
    && data.get('createdAt', null) == previous.get('createdAt', null)
    && data.get('updatedBy', '') == request.auth.uid
    && data.get('updatedAt', null) == request.time;
}

function proClubWeeklyTrainingStrictCalendarDateV1(value) {
  let parsed = timestamp.date(
    int(value[0:4]),
    int(value[5:7]),
    int(value[8:10])
  );
  return value is string
    && value.matches('^\\d{4}-\\d{2}-\\d{2}$')
    && parsed.year() == int(value[0:4])
    && parsed.month() == int(value[5:7])
    && parsed.day() == int(value[8:10]);
}

function proClubWeeklyTrainingDateTimestampV1(value) {
  return timestamp.date(
    int(value[0:4]),
    int(value[5:7]),
    int(value[8:10])
  );
}

function proClubWeeklyTrainingNormalizedTextV1(value, maxLength) {
  return value is string
    && value.size() > 0
    && value.size() <= maxLength
    && value.trim() == value;
}

function proClubWeeklyTrainingValidPlanKeysV1(data) {
  return data.keys().hasOnly([
      'schemaVersion', 'authorUid', 'status', 'weekStartDate', 'squadLabel',
      'mainObjective', 'secondaryObjective', 'headCoachNote',
      'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ])
    && data.keys().hasAll([
      'schemaVersion', 'authorUid', 'status', 'weekStartDate', 'squadLabel',
      'mainObjective', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ]);
}

function proClubWeeklyTrainingValidPlanValuesV1(data) {
  return data.get('schemaVersion', 0) == 1
    && exactDocumentId(data.get('authorUid', ''))
    && data.get('status', '') == 'DRAFT'
    && proClubWeeklyTrainingStrictCalendarDateV1(data.get('weekStartDate', ''))
    && proClubWeeklyTrainingNormalizedTextV1(data.get('squadLabel', ''), 100)
    && proClubWeeklyTrainingNormalizedTextV1(data.get('mainObjective', ''), 500)
    && (!data.keys().hasAny(['secondaryObjective'])
      || proClubWeeklyTrainingNormalizedTextV1(data.secondaryObjective, 500))
    && (!data.keys().hasAny(['headCoachNote'])
      || proClubWeeklyTrainingNormalizedTextV1(data.headCoachNote, 2000));
}

function proClubWeeklyTrainingValidDraftPlanCreateV1(clubId) {
  return currentUserIsActive()
    && proClubWeeklyTrainingActiveHeadCoachV1(clubId, request.auth.uid)
    && proClubWeeklyTrainingCurrentAuthorityIsValidV1(clubId)
    && proClubWeeklyTrainingValidPlanKeysV1(request.resource.data)
    && proClubWeeklyTrainingValidPlanValuesV1(request.resource.data)
    && request.resource.data.get('authorUid', '') == request.auth.uid
    && proClubWeeklyTrainingValidAuditCreateV1(request.resource.data);
}

function proClubWeeklyTrainingValidDraftPlanUpdateV1(clubId) {
  return currentUserIsActive()
    && proClubWeeklyTrainingActiveHeadCoachV1(clubId, request.auth.uid)
    && proClubWeeklyTrainingCurrentAuthorityIsValidV1(clubId)
    && resource.data.get('status', '') == 'DRAFT'
    && request.resource.data.get('status', '') == 'DRAFT'
    && resource.data.get('authorUid', '') == request.auth.uid
    && request.resource.data.get('authorUid', '') == request.auth.uid
    && proClubWeeklyTrainingValidPlanKeysV1(request.resource.data)
    && proClubWeeklyTrainingValidPlanValuesV1(request.resource.data)
    && request.resource.data.get('schemaVersion', 0)
      == resource.data.get('schemaVersion', 0)
    && request.resource.data.get('weekStartDate', '')
      == resource.data.get('weekStartDate', '')
    && proClubWeeklyTrainingValidAuditUpdateV1(
      request.resource.data,
      resource.data
    );
}

function proClubWeeklyTrainingParentDraftOwnedByActorV1(clubId, planId) {
  let planPath =
    /databases/$(database)/documents/proClubs/$(clubId)/weeklyTrainingPlans/$(planId);
  let plan = get(planPath).data;
  return currentUserIsActive()
    && proClubWeeklyTrainingActiveHeadCoachV1(clubId, request.auth.uid)
    && proClubWeeklyTrainingCurrentAuthorityIsValidV1(clubId)
    && exists(planPath)
    && plan.get('schemaVersion', 0) == 1
    && plan.get('status', '') == 'DRAFT'
    && plan.get('authorUid', '') == request.auth.uid;
}

function proClubWeeklyTrainingParentPlanV1(clubId, planId) {
  return get(
    /databases/$(database)/documents/proClubs/$(clubId)/weeklyTrainingPlans/$(planId)
  ).data;
}

function proClubWeeklyTrainingValidSessionKeysV1(data) {
  return data.keys().hasOnly([
      'schemaVersion', 'orderIndex', 'sessionDate', 'startTime', 'location',
      'objective', 'phaseOfPlay', 'plannedLoad', 'durationMinutes',
      'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ])
    && data.keys().hasAll([
      'schemaVersion', 'orderIndex', 'sessionDate', 'startTime', 'location',
      'objective', 'phaseOfPlay', 'plannedLoad', 'durationMinutes',
      'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ]);
}

function proClubWeeklyTrainingValidSessionValuesV1(data) {
  return data.get('schemaVersion', 0) == 1
    && data.get('orderIndex', -1) is int
    && data.get('orderIndex', -1) >= 0
    && data.get('orderIndex', -1) <= 13
    && proClubWeeklyTrainingStrictCalendarDateV1(data.get('sessionDate', ''))
    && data.get('startTime', '') is string
    && data.get('startTime', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
    && proClubWeeklyTrainingNormalizedTextV1(data.get('location', ''), 200)
    && proClubWeeklyTrainingNormalizedTextV1(data.get('objective', ''), 500)
    && data.get('phaseOfPlay', '') in [
      'GENERAL', 'IN_POSSESSION', 'OUT_OF_POSSESSION',
      'TRANSITION_TO_ATTACK', 'TRANSITION_TO_DEFEND', 'SET_PIECES'
    ]
    && data.get('plannedLoad', '') in ['LOW', 'MODERATE', 'HIGH']
    && data.get('durationMinutes', 0) is int
    && data.get('durationMinutes', 0) >= 15
    && data.get('durationMinutes', 0) <= 360;
}

function proClubWeeklyTrainingSessionIdMatchesPayloadV1(sessionId, data) {
  return sessionId
    == data.get('sessionDate', '') + '-' + data.get('startTime', '').replace(':', '');
}

function proClubWeeklyTrainingSessionDateInsideParentWeekV1(
  clubId,
  planId,
  data
) {
  let plan = proClubWeeklyTrainingParentPlanV1(clubId, planId);
  let sessionDate = proClubWeeklyTrainingDateTimestampV1(data.get('sessionDate', ''));
  let weekStart = proClubWeeklyTrainingDateTimestampV1(plan.get('weekStartDate', ''));
  return proClubWeeklyTrainingStrictCalendarDateV1(plan.get('weekStartDate', ''))
    && proClubWeeklyTrainingStrictCalendarDateV1(data.get('sessionDate', ''))
    && sessionDate >= weekStart
    && sessionDate <= weekStart + duration.value(6, 'd');
}

function proClubWeeklyTrainingValidSessionCreateV1(clubId, planId, sessionId) {
  return proClubWeeklyTrainingParentDraftOwnedByActorV1(clubId, planId)
    && proClubWeeklyTrainingValidSessionKeysV1(request.resource.data)
    && proClubWeeklyTrainingValidSessionValuesV1(request.resource.data)
    && proClubWeeklyTrainingSessionIdMatchesPayloadV1(sessionId, request.resource.data)
    && proClubWeeklyTrainingSessionDateInsideParentWeekV1(
      clubId,
      planId,
      request.resource.data
    )
    && proClubWeeklyTrainingValidAuditCreateV1(request.resource.data);
}

function proClubWeeklyTrainingValidSessionUpdateV1(clubId, planId, sessionId) {
  return proClubWeeklyTrainingParentDraftOwnedByActorV1(clubId, planId)
    && proClubWeeklyTrainingValidSessionKeysV1(request.resource.data)
    && proClubWeeklyTrainingValidSessionValuesV1(request.resource.data)
    && proClubWeeklyTrainingSessionIdMatchesPayloadV1(sessionId, request.resource.data)
    && proClubWeeklyTrainingSessionDateInsideParentWeekV1(
      clubId,
      planId,
      request.resource.data
    )
    && request.resource.data.get('schemaVersion', 0)
      == resource.data.get('schemaVersion', 0)
    && request.resource.data.get('orderIndex', -1)
      == resource.data.get('orderIndex', -1)
    && request.resource.data.get('sessionDate', '')
      == resource.data.get('sessionDate', '')
    && request.resource.data.get('startTime', '')
      == resource.data.get('startTime', '')
    && proClubWeeklyTrainingValidAuditUpdateV1(
      request.resource.data,
      resource.data
    );
}

function proClubWeeklyTrainingValidPointV1(point) {
  return proClubWeeklyTrainingNormalizedTextV1(point, 300);
}

function proClubWeeklyTrainingValidCoachingPointsV1(points) {
  return points is list
    && proClubWeeklyTrainingValidCoachingPointsListV1(points);
}

function proClubWeeklyTrainingValidCoachingPointsListV1(points) {
  let pointCount = points.size();

  return pointCount >= 1
    && pointCount <= 10
    && proClubWeeklyTrainingValidPointV1(points[0])
    && (pointCount < 2 || proClubWeeklyTrainingValidPointV1(points[1]))
    && (pointCount < 3 || proClubWeeklyTrainingValidPointV1(points[2]))
    && (pointCount < 4 || proClubWeeklyTrainingValidPointV1(points[3]))
    && (pointCount < 5 || proClubWeeklyTrainingValidPointV1(points[4]))
    && (pointCount < 6 || proClubWeeklyTrainingValidPointV1(points[5]))
    && (pointCount < 7 || proClubWeeklyTrainingValidPointV1(points[6]))
    && (pointCount < 8 || proClubWeeklyTrainingValidPointV1(points[7]))
    && (pointCount < 9 || proClubWeeklyTrainingValidPointV1(points[8]))
    && (pointCount < 10 || proClubWeeklyTrainingValidPointV1(points[9]));
}

function proClubWeeklyTrainingValidBlockKeysV1(data) {
  return data.keys().hasOnly([
      'schemaVersion', 'orderIndex', 'blockType', 'title', 'durationMinutes',
      'drillReference', 'coachingPoints',
      'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ])
    && data.keys().hasAll([
      'schemaVersion', 'orderIndex', 'blockType', 'title', 'durationMinutes',
      'coachingPoints', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ]);
}

function proClubWeeklyTrainingValidExactDocumentIdentifierV1(value) {
  return value is string
    && value.size() > 0
    && value.trim() == value
    && !value.matches('.*[/].*');
}

function proClubWeeklyTrainingValidBlockValuesV1(data) {
  let orderIndex = data.get('orderIndex', -1);
  let durationMinutes = data.get('durationMinutes', 0);
  let coachingPoints = data.get('coachingPoints', []);
  return data.get('schemaVersion', 0) == 1
    && orderIndex is int
    && orderIndex >= 0
    && orderIndex <= 11
    && data.get('blockType', '') in [
      'WARM_UP', 'TECHNICAL', 'TACTICAL', 'GAME',
      'CONDITIONING', 'COOL_DOWN', 'OTHER'
    ]
    && proClubWeeklyTrainingNormalizedTextV1(data.get('title', ''), 200)
    && durationMinutes is int
    && durationMinutes >= 1
    && durationMinutes <= 180
    && (!data.keys().hasAny(['drillReference'])
      || proClubWeeklyTrainingValidExactDocumentIdentifierV1(data.drillReference))
    && proClubWeeklyTrainingValidCoachingPointsV1(coachingPoints);
}

function proClubWeeklyTrainingBlockIdMatchesOrderV1(blockId, orderIndex) {
  let blockIdsByOrder = [
    'block-01', 'block-02', 'block-03', 'block-04',
    'block-05', 'block-06', 'block-07', 'block-08',
    'block-09', 'block-10', 'block-11', 'block-12'
  ];
  return orderIndex is int
    && orderIndex >= 0
    && orderIndex <= 11
    && blockId == blockIdsByOrder[orderIndex];
}

function proClubWeeklyTrainingSessionExistsV1(clubId, planId, sessionId) {
  return exists(
    /databases/$(database)/documents/proClubs/$(clubId)/weeklyTrainingPlans/$(planId)/sessions/$(sessionId)
  );
}

function proClubWeeklyTrainingValidBlockCreateV1(
  clubId,
  planId,
  sessionId,
  blockId
) {
  let data = request.resource.data;
  return proClubWeeklyTrainingValidBlockKeysV1(data)
    && proClubWeeklyTrainingValidBlockValuesV1(data)
    && proClubWeeklyTrainingBlockIdMatchesOrderV1(
      blockId,
      data.get('orderIndex', -1)
    )
    && proClubWeeklyTrainingValidAuditCreateV1(data)
    && proClubWeeklyTrainingParentDraftOwnedByActorV1(clubId, planId)
    && proClubWeeklyTrainingSessionExistsV1(clubId, planId, sessionId);
}

function proClubWeeklyTrainingValidBlockUpdateV1(
  clubId,
  planId,
  sessionId,
  blockId
) {
  let data = request.resource.data;
  let previous = resource.data;
  return proClubWeeklyTrainingValidBlockKeysV1(data)
    && proClubWeeklyTrainingValidBlockValuesV1(data)
    && proClubWeeklyTrainingBlockIdMatchesOrderV1(
      blockId,
      data.get('orderIndex', -1)
    )
    && data.get('schemaVersion', 0)
      == previous.get('schemaVersion', 0)
    && data.get('orderIndex', -1)
      == previous.get('orderIndex', -1)
    && proClubWeeklyTrainingValidAuditUpdateV1(
      data,
      previous
    )
    && proClubWeeklyTrainingParentDraftOwnedByActorV1(clubId, planId)
    && proClubWeeklyTrainingSessionExistsV1(clubId, planId, sessionId);
}

// Pro Club Weekly Training Production Persistence V1 — schema-v2 create-only.
function proClubWeeklyTrainingProductionManifestPathV2(clubId, planId) {
  return /databases/$(database)/documents/proClubs/$(clubId)/weeklyTrainingDraftCreateRequests/$(planId);
}

function proClubWeeklyTrainingProductionPlanPathV2(clubId, planId) {
  return /databases/$(database)/documents/proClubs/$(clubId)/weeklyTrainingPlans/$(planId);
}

function proClubWeeklyTrainingClubIsActiveV2(clubId) {
  let clubPath = /databases/$(database)/documents/proClubs/$(clubId);
  let club = get(clubPath).data;
  return exists(clubPath)
    && validProClubDocumentForAuthorityV1(club)
    && club.get('status', '') == 'ACTIVE';
}

function proClubWeeklyTrainingActorIsActiveHeadCoachV2(clubId) {
  let membershipPath = /databases/$(database)/documents/proClubs/$(clubId)/members/$(request.auth.uid);
  let staffPath = /databases/$(database)/documents/proClubs/$(clubId)/staff/$(request.auth.uid);
  let membership = get(membershipPath).data;
  let staff = get(staffPath).data;
  return currentUserIsActive()
    && exists(membershipPath)
    && exists(staffPath)
    && validProClubMembershipDataV1(membership)
    && validProClubStaffDataV1(staff)
    && membership.get('status', '') == 'ACTIVE'
    && staff.get('status', '') == 'ACTIVE'
    && staff.get('staffRole', '') == 'HEAD_COACH';
}

function proClubWeeklyTrainingExactFreshAuditV2(data) {
  return data.get('createdAt', null) == request.time
    && data.get('updatedAt', null) == request.time
    && data.get('createdBy', '') == request.auth.uid
    && data.get('updatedBy', '') == request.auth.uid;
}

function proClubWeeklyTrainingValidManifestKeysV2(data) {
  return data.keys().hasOnly([
      'schemaVersion', 'requestId', 'planId', 'actorUid', 'weekStartDate',
      'sessionCount', 'documentCount', 'createdAt', 'createdBy'
    ])
    && data.keys().hasAll([
      'schemaVersion', 'requestId', 'planId', 'actorUid', 'weekStartDate',
      'sessionCount', 'documentCount', 'createdAt', 'createdBy'
    ]);
}

function proClubWeeklyTrainingValidManifestCreateV2(clubId, planId) {
  let data = request.resource.data;
  let projectedPlan = getAfter(proClubWeeklyTrainingProductionPlanPathV2(clubId, planId)).data;
  return proClubWeeklyTrainingClubIsActiveV2(clubId)
    && proClubWeeklyTrainingActorIsActiveHeadCoachV2(clubId)
    && proClubWeeklyTrainingCurrentAuthorityIsValidV1(clubId)
    && proClubWeeklyTrainingValidManifestKeysV2(data)
    && data.get('schemaVersion', 0) == 1
    && data.get('requestId', '') == planId
    && data.get('planId', '') == planId
    && data.get('actorUid', '') == request.auth.uid
    && proClubWeeklyTrainingStrictCalendarDateV1(data.get('weekStartDate', ''))
    && data.get('sessionCount', 0) is int
    && data.get('sessionCount', 0) >= 1
    && data.get('sessionCount', 0) <= 14
    && data.get('documentCount', 0) is int
    && data.get('documentCount', 0) >= 4
    && data.get('documentCount', 0) <= 184
    && data.get('createdAt', null) == request.time
    && data.get('createdBy', '') == request.auth.uid
    && projectedPlan.get('schemaVersion', 0) == 2
    && projectedPlan.get('status', '') == 'DRAFT'
    && projectedPlan.get('authorUid', '') == request.auth.uid
    && projectedPlan.get('weekStartDate', '') == data.get('weekStartDate', '')
    && projectedPlan.get('sessionCount', 0) == data.get('sessionCount', 0)
    && projectedPlan.get('createdAt', null) == request.time
    && projectedPlan.get('updatedAt', null) == request.time
    && projectedPlan.get('createdBy', '') == request.auth.uid
    && projectedPlan.get('updatedBy', '') == request.auth.uid;
}

function proClubWeeklyTrainingProjectedManifestV2(clubId, planId) {
  return getAfter(proClubWeeklyTrainingProductionManifestPathV2(clubId, planId)).data;
}

function proClubWeeklyTrainingBoundToProjectedManifestV2(clubId, planId) {
  let manifest = proClubWeeklyTrainingProjectedManifestV2(clubId, planId);
  return isSignedIn()
    && manifest.get('schemaVersion', 0) == 1
    && manifest.get('requestId', '') == planId
    && manifest.get('planId', '') == planId
    && manifest.get('actorUid', '') == request.auth.uid
    && manifest.get('createdAt', null) == request.time
    && manifest.get('createdBy', '') == request.auth.uid;
}

function proClubWeeklyTrainingValidPlanKeysV2(data) {
  return data.keys().hasOnly([
      'schemaVersion', 'authorUid', 'status', 'weekStartDate', 'squadLabel',
      'mainObjective', 'secondaryObjective', 'headCoachNote', 'sessionCount',
      'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ])
    && data.keys().hasAll([
      'schemaVersion', 'authorUid', 'status', 'weekStartDate', 'squadLabel',
      'mainObjective', 'sessionCount', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ]);
}

function proClubWeeklyTrainingValidPlanCreateV2(clubId, planId) {
  let data = request.resource.data;
  let manifest = proClubWeeklyTrainingProjectedManifestV2(clubId, planId);
  return proClubWeeklyTrainingBoundToProjectedManifestV2(clubId, planId)
    && proClubWeeklyTrainingValidPlanKeysV2(data)
    && data.get('schemaVersion', 0) == 2
    && data.get('authorUid', '') == request.auth.uid
    && data.get('status', '') == 'DRAFT'
    && data.get('weekStartDate', '') == manifest.get('weekStartDate', '')
    && proClubWeeklyTrainingNormalizedTextV1(data.get('squadLabel', ''), 100)
    && proClubWeeklyTrainingNormalizedTextV1(data.get('mainObjective', ''), 500)
    && (!data.keys().hasAny(['secondaryObjective'])
      || proClubWeeklyTrainingNormalizedTextV1(data.secondaryObjective, 500))
    && (!data.keys().hasAny(['headCoachNote'])
      || proClubWeeklyTrainingNormalizedTextV1(data.headCoachNote, 2000))
    && data.get('sessionCount', 0) == manifest.get('sessionCount', 0)
    && proClubWeeklyTrainingExactFreshAuditV2(data);
}

function proClubWeeklyTrainingValidSessionKeysV2(data) {
  return data.keys().hasOnly([
      'schemaVersion', 'orderIndex', 'sessionDate', 'startTime', 'location',
      'objective', 'phaseOfPlay', 'plannedLoad', 'durationMinutes', 'blockCount',
      'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ])
    && data.keys().hasAll([
      'schemaVersion', 'orderIndex', 'sessionDate', 'startTime', 'location',
      'objective', 'phaseOfPlay', 'plannedLoad', 'durationMinutes', 'blockCount',
      'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ]);
}

function proClubWeeklyTrainingValidSessionCreateV2(clubId, planId, sessionId) {
  let data = request.resource.data;
  return proClubWeeklyTrainingBoundToProjectedManifestV2(clubId, planId)
    && proClubWeeklyTrainingValidSessionKeysV2(data)
    && data.get('schemaVersion', 0) == 2
    && data.get('orderIndex', -1) is int
    && data.get('orderIndex', -1) >= 0
    && data.get('orderIndex', -1) <= 13
    && proClubWeeklyTrainingStrictCalendarDateV1(data.get('sessionDate', ''))
    && data.get('startTime', '') is string
    && data.get('startTime', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
    && proClubWeeklyTrainingSessionIdMatchesPayloadV1(sessionId, data)
    && proClubWeeklyTrainingNormalizedTextV1(data.get('location', ''), 200)
    && proClubWeeklyTrainingNormalizedTextV1(data.get('objective', ''), 500)
    && data.get('phaseOfPlay', '') in [
      'GENERAL', 'IN_POSSESSION', 'OUT_OF_POSSESSION',
      'TRANSITION_TO_ATTACK', 'TRANSITION_TO_DEFEND', 'SET_PIECES'
    ]
    && data.get('plannedLoad', '') in ['LOW', 'MODERATE', 'HIGH']
    && data.get('durationMinutes', 0) is int
    && data.get('durationMinutes', 0) >= 15
    && data.get('durationMinutes', 0) <= 360
    && data.get('blockCount', 0) is int
    && data.get('blockCount', 0) >= 1
    && data.get('blockCount', 0) <= 12
    && proClubWeeklyTrainingExactFreshAuditV2(data);
}

function proClubWeeklyTrainingValidBlockKeysV2(data) {
  return data.keys().hasOnly([
      'schemaVersion', 'orderIndex', 'blockType', 'title', 'durationMinutes',
      'drillReference', 'coachingPoints', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ])
    && data.keys().hasAll([
      'schemaVersion', 'orderIndex', 'blockType', 'title', 'durationMinutes',
      'coachingPoints', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
    ]);
}

function proClubWeeklyTrainingValidBlockCreateV2(clubId, planId, sessionId, blockId) {
  let data = request.resource.data;
  return proClubWeeklyTrainingBoundToProjectedManifestV2(clubId, planId)
    && proClubWeeklyTrainingValidBlockKeysV2(data)
    && data.get('schemaVersion', 0) == 2
    && data.get('orderIndex', -1) is int
    && data.get('orderIndex', -1) >= 0
    && data.get('orderIndex', -1) <= 11
    && proClubWeeklyTrainingBlockIdMatchesOrderV1(blockId, data.get('orderIndex', -1))
    && data.get('blockType', '') in [
      'WARM_UP', 'TECHNICAL', 'TACTICAL', 'GAME',
      'CONDITIONING', 'COOL_DOWN', 'OTHER'
    ]
    && proClubWeeklyTrainingNormalizedTextV1(data.get('title', ''), 200)
    && data.get('durationMinutes', 0) is int
    && data.get('durationMinutes', 0) >= 1
    && data.get('durationMinutes', 0) <= 180
    && (!data.keys().hasAny(['drillReference'])
      || proClubWeeklyTrainingValidExactDocumentIdentifierV1(data.drillReference))
    && proClubWeeklyTrainingValidCoachingPointsV1(data.get('coachingPoints', []))
    && proClubWeeklyTrainingExactFreshAuditV2(data);
}

// Existing-DRAFT Edit V1 — direct schema-v2 client updates stay closed.
// Firestore Rules cannot enumerate dynamic descendants to prove a complete
// hierarchy update. The future trusted B3 writer owns that transaction.

match /proClubs/{clubId}/technicalGovernance/current {
  allow get: if currentUserIsActive()
    && proClubWeeklyTrainingActiveMemberV1(clubId, request.auth.uid)
    && proClubWeeklyTrainingActiveStaffV1(clubId, request.auth.uid);
  allow list, create, update, delete: if false;
}

// Pro Club Weekly Training Production Persistence V1 — manifest + schema-v2 creates.
match /proClubs/{clubId}/weeklyTrainingDraftCreateRequests/{planId} {
  allow get: if currentUserIsActive()
    && resource.data.get('actorUid', '') == request.auth.uid;
  allow list, update, delete: if false;
  allow create: if proClubWeeklyTrainingValidManifestCreateV2(clubId, planId);
}

match /proClubs/{clubId}/weeklyTrainingPlans/{planId} {
  allow get, list: if currentUserIsActive()
    && proClubWeeklyTrainingActiveMemberV1(clubId, request.auth.uid);
  allow create: if request.resource.data.get('schemaVersion', 0) == 2
    ? proClubWeeklyTrainingValidPlanCreateV2(clubId, planId)
    : (
      request.resource.data.get('schemaVersion', 0) == 1
        && proClubWeeklyTrainingValidDraftPlanCreateV1(clubId)
    );
  allow update: if request.resource.data.get('schemaVersion', 0) == 2
    ? false
    : (
      request.resource.data.get('schemaVersion', 0) == 1
        && proClubWeeklyTrainingValidDraftPlanUpdateV1(clubId)
    );
  allow delete: if false;

  match /sessions/{sessionId} {
    allow get, list: if currentUserIsActive()
      && proClubWeeklyTrainingActiveMemberV1(clubId, request.auth.uid);
    allow create: if request.resource.data.get('schemaVersion', 0) == 2
      ? proClubWeeklyTrainingValidSessionCreateV2(
        clubId,
        planId,
        sessionId
      )
      : (
        request.resource.data.get('schemaVersion', 0) == 1
          && proClubWeeklyTrainingValidSessionCreateV1(
            clubId,
            planId,
            sessionId
          )
      );
    allow update: if request.resource.data.get('schemaVersion', 0) == 2
      ? false
      : (
        request.resource.data.get('schemaVersion', 0) == 1
          && proClubWeeklyTrainingValidSessionUpdateV1(
            clubId,
            planId,
            sessionId
          )
      );
    allow delete: if false;

    match /blocks/{blockId} {
      allow get, list: if currentUserIsActive()
        && proClubWeeklyTrainingActiveMemberV1(clubId, request.auth.uid);
      allow create: if request.resource.data.get('schemaVersion', 0) == 2
        ? proClubWeeklyTrainingValidBlockCreateV2(
          clubId,
          planId,
          sessionId,
          blockId
        )
        : (
          request.resource.data.get('schemaVersion', 0) == 1
            && proClubWeeklyTrainingValidBlockCreateV1(
              clubId,
              planId,
              sessionId,
              blockId
            )
        );
      allow update: if request.resource.data.get('schemaVersion', 0) == 2
        ? false
        : (
          request.resource.data.get('schemaVersion', 0) == 1
            && proClubWeeklyTrainingValidBlockUpdateV1(
              clubId,
              planId,
              sessionId,
              blockId
            )
        );
      allow delete: if false;
    }
  }
}

    match /proClubOnboardingControlAudits/{actionId} {
      allow get, list: if isSuperAdmin();
      // Branch on canonical global role first so an INACTIVE SUPERADMIN fails
      // before the expensive same-commit audit validator is evaluated.
      allow create: if currentUserHasSuperAdminRoleV1()
        ? (
          currentUserIsActive()
            ? validProClubOnboardingControlAuditCreateV1(actionId)
            : false
        )
        : false;
      allow update, delete: if false;
    }

    match /proClubInvites/{inviteCode} {
      allow get: if isSignedIn()
        && (
          (
            // Exact-code capability lookup exposes only the closed V1 schema.
            // Expiry restricts claim/approval writes, not status inspection.
            validProClubActiveInviteDataV1(resource.data, inviteCode)
            || validProClubRevokedInviteDataV1(resource.data, inviteCode)
            || validProClubConsumedInviteDataV1(resource.data, inviteCode)
          )
          || isActiveProClubReviewerV1(
            resource.data.get('clubId', '')
          )
        );
      allow list: if false;
      allow create: if validProClubInviteCreateV1(inviteCode);
      allow update: if resource != null
        && (
          request.resource.data.get('status', '') == 'CONSUMED'
            ? validProClubInviteConsumptionV1(inviteCode)
            : (
              request.resource.data.get('status', '') == 'REVOKED'
              && validProClubInviteRevocationV1(inviteCode)
            )
        );
      allow delete: if false;
    }

    // Pro Club Firestore Rules V1 + Onboarding Slice 2B.
    //
    // Relationship evidence remains distinct from tenant authority. Exact own
    // Membership/Staff reads are preserved for runtime classification. Client
    // writes are opened only for the reviewed invite/claim approval lifecycle.
    match /proClubs/{clubId} {
      // Pro Club Staff Submissions V1 — shared football staff work-review boundary.
      function proClubStaffSubmissionActiveAuthorV1(clubId) {
        let clubPath =
          /databases/$(database)/documents/proClubs/$(clubId);
        let membershipPath =
          /databases/$(database)/documents/proClubs/$(clubId)/members/$(request.auth.uid);
        let staffPath =
          /databases/$(database)/documents/proClubs/$(clubId)/staff/$(request.auth.uid);
        return currentUserIsActive()
          && exists(clubPath)
          && get(clubPath).data.get('status', '') == 'ACTIVE'
          && exists(membershipPath)
          && get(membershipPath).data.get('status', '') == 'ACTIVE'
          && exists(staffPath)
          && get(staffPath).data.get('status', '') == 'ACTIVE'
          && get(staffPath).data.get('staffRole', '') in [
            'ASSISTANT_COACH',
            'GK_COACH',
            'FITNESS_COACH',
            'ANALYST',
            'PHYSIO'
          ];
      }

      function proClubStaffSubmissionActorRoleV1(clubId) {
        return get(
          /databases/$(database)/documents/proClubs/$(clubId)/staff/$(request.auth.uid)
        ).data.get('staffRole', '');
      }

      function proClubStaffSubmissionWorkTypeMatchesRoleV1(role, workType) {
        return (
            role == 'ASSISTANT_COACH' && workType == 'TRAINING_SUPPORT'
          ) || (
            role == 'GK_COACH' && workType == 'GK_TRAINING'
          ) || (
            role == 'FITNESS_COACH' && workType == 'FITNESS'
          ) || (
            role == 'ANALYST' && workType == 'ANALYSIS'
          ) || (
            role == 'PHYSIO' && workType == 'PHYSIO'
          );
      }

      function proClubStaffSubmissionActorIsTechnicalAuthorityV1(clubId) {
        let clubPath =
          /databases/$(database)/documents/proClubs/$(clubId);
        let membershipPath =
          /databases/$(database)/documents/proClubs/$(clubId)/members/$(request.auth.uid);
        let staffPath =
          /databases/$(database)/documents/proClubs/$(clubId)/staff/$(request.auth.uid);
        let authorityPath =
          /databases/$(database)/documents/proClubs/$(clubId)/technicalGovernance/current;
        let staff = get(staffPath).data;
        let authority = get(authorityPath).data;
        return currentUserIsActive()
          && exists(clubPath)
          && get(clubPath).data.get('status', '') == 'ACTIVE'
          && exists(membershipPath)
          && get(membershipPath).data.get('status', '') == 'ACTIVE'
          && exists(staffPath)
          && staff.get('status', '') == 'ACTIVE'
          && exists(authorityPath)
          && authority.get('schemaVersion', 0) == 1
          && authority.get('status', '') == 'ACTIVE'
          && authority.get('authorityUid', '') == request.auth.uid
          && authority.get('authorityRole', '')
            in ['TECHNICAL_DIRECTOR', 'HEAD_COACH']
          && staff.get('staffRole', '')
            == authority.get('authorityRole', '');
      }

      function proClubStaffSubmissionValidContentV1(data) {
        return data.get('title', '') is string
          && data.get('title', '').size() > 0
          && data.get('title', '').size() <= 160
          && data.get('title', '').trim() == data.get('title', '')
          && data.get('summary', '') is string
          && data.get('summary', '').size() > 0
          && data.get('summary', '').size() <= 5000
          && data.get('summary', '').trim() == data.get('summary', '')
          && (
            data.get('targetPlanId', null) == null
            || exactDocumentId(data.get('targetPlanId', ''))
          )
          && (
            data.get('targetSessionDate', null) == null
            || proClubWeeklyTrainingStrictCalendarDateV1(
              data.get('targetSessionDate', '')
            )
          )
          && (
            data.get('targetSessionDate', null) == null
            || data.get('targetPlanId', null) != null
          );
      }

      function proClubStaffSubmissionHasCanonicalKeysV1(data) {
        return data.keys().hasAll([
            'schemaVersion',
            'authorUid',
            'authorRole',
            'workType',
            'title',
            'summary',
            'module',
            'targetPlanId',
            'targetSessionDate',
            'status',
            'reviewerUid',
            'reviewerRole',
            'reviewNote',
            'createdAt',
            'createdBy',
            'updatedAt',
            'updatedBy',
            'submittedAt',
            'submittedBy',
            'reviewStartedAt',
            'reviewStartedBy',
            'revisionRequestedAt',
            'revisionRequestedBy',
            'approvedAt',
            'approvedBy'
          ])
          && data.keys().hasOnly([
            'schemaVersion',
            'authorUid',
            'authorRole',
            'workType',
            'title',
            'summary',
            'module',
            'targetPlanId',
            'targetSessionDate',
            'status',
            'reviewerUid',
            'reviewerRole',
            'reviewNote',
            'createdAt',
            'createdBy',
            'updatedAt',
            'updatedBy',
            'submittedAt',
            'submittedBy',
            'reviewStartedAt',
            'reviewStartedBy',
            'revisionRequestedAt',
            'revisionRequestedBy',
            'approvedAt',
            'approvedBy'
          ]);
      }

      function proClubStaffSubmissionValidCreateV1(data) {
        return proClubStaffSubmissionActiveAuthorV1(clubId)
          && proClubStaffSubmissionHasCanonicalKeysV1(data)
          && data.get('schemaVersion', 0) == 1
          && data.get('authorUid', '') == request.auth.uid
          && data.get('authorRole', '')
            == proClubStaffSubmissionActorRoleV1(clubId)
          && proClubStaffSubmissionWorkTypeMatchesRoleV1(
            data.get('authorRole', ''),
            data.get('workType', '')
          )
          && proClubStaffSubmissionValidContentV1(data)
          && data.get('module', '') == 'TRAINING'
          && data.get('status', '') == 'DRAFT'
          && data.get('reviewerUid', null) == null
          && data.get('reviewerRole', null) == null
          && data.get('reviewNote', null) == null
          && data.get('createdAt', null) == request.time
          && data.get('createdBy', '') == request.auth.uid
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid
          && data.get('submittedAt', null) == null
          && data.get('submittedBy', null) == null
          && data.get('reviewStartedAt', null) == null
          && data.get('reviewStartedBy', null) == null
          && data.get('revisionRequestedAt', null) == null
          && data.get('revisionRequestedBy', null) == null
          && data.get('approvedAt', null) == null
          && data.get('approvedBy', null) == null;
      }

      function proClubStaffSubmissionAuthorOwnsV1(previous) {
        return proClubStaffSubmissionActiveAuthorV1(clubId)
          && previous.get('schemaVersion', 0) == 1
          && previous.get('module', '') == 'TRAINING'
          && previous.get('authorUid', '') == request.auth.uid
          && previous.get('authorRole', '')
            == proClubStaffSubmissionActorRoleV1(clubId)
          && proClubStaffSubmissionWorkTypeMatchesRoleV1(
            previous.get('authorRole', ''),
            previous.get('workType', '')
          );
      }

      function proClubStaffSubmissionValidAuthorContentEditV1(data, previous) {
        return proClubStaffSubmissionAuthorOwnsV1(previous)
          && previous.get('status', '') in ['DRAFT', 'NEEDS_REVISION']
          && data.get('status', '') == previous.get('status', '')
          && data.diff(previous).affectedKeys().hasOnly([
            'workType',
            'title',
            'summary',
            'targetPlanId',
            'targetSessionDate',
            'updatedAt',
            'updatedBy'
          ])
          && proClubStaffSubmissionWorkTypeMatchesRoleV1(
            previous.get('authorRole', ''),
            data.get('workType', '')
          )
          && proClubStaffSubmissionValidContentV1(data)
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid;
      }

      function proClubStaffSubmissionValidAuthorSubmitV1(data, previous) {
        return proClubStaffSubmissionAuthorOwnsV1(previous)
          && previous.get('status', '') in ['DRAFT', 'NEEDS_REVISION']
          && data.get('status', '') == 'SUBMITTED'
          && data.diff(previous).affectedKeys().hasOnly([
            'status',
            'submittedAt',
            'submittedBy',
            'updatedAt',
            'updatedBy'
          ])
          && data.get('submittedAt', null) == request.time
          && data.get('submittedBy', '') == request.auth.uid
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid;
      }

      function proClubStaffSubmissionValidReviewStartV1(data, previous) {
        return proClubStaffSubmissionActorIsTechnicalAuthorityV1(clubId)
          && previous.get('schemaVersion', 0) == 1
          && previous.get('module', '') == 'TRAINING'
          && previous.get('authorUid', '') != request.auth.uid
          && previous.get('status', '') == 'SUBMITTED'
          && data.get('status', '') == 'IN_REVIEW'
          && data.diff(previous).affectedKeys().hasOnly([
            'status',
            'reviewerUid',
            'reviewerRole',
            'reviewStartedAt',
            'reviewStartedBy',
            'updatedAt',
            'updatedBy'
          ])
          && data.get('reviewerUid', '') == request.auth.uid
          && data.get('reviewerRole', '')
            == proClubStaffSubmissionActorRoleV1(clubId)
          && data.get('reviewStartedAt', null) == request.time
          && data.get('reviewStartedBy', '') == request.auth.uid
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid;
      }

      function proClubStaffSubmissionValidRevisionRequestV1(data, previous) {
        return proClubStaffSubmissionActorIsTechnicalAuthorityV1(clubId)
          && previous.get('schemaVersion', 0) == 1
          && previous.get('module', '') == 'TRAINING'
          && previous.get('authorUid', '') != request.auth.uid
          && previous.get('status', '') == 'IN_REVIEW'
          && previous.get('reviewerUid', '') == request.auth.uid
          && previous.get('reviewerRole', '')
            == proClubStaffSubmissionActorRoleV1(clubId)
          && data.get('status', '') == 'NEEDS_REVISION'
          && data.diff(previous).affectedKeys().hasOnly([
            'status',
            'reviewNote',
            'revisionRequestedAt',
            'revisionRequestedBy',
            'updatedAt',
            'updatedBy'
          ])
          && data.get('reviewNote', null) is string
          && data.get('reviewNote', '').size() > 0
          && data.get('reviewNote', '').size() <= 2000
          && data.get('reviewNote', '').trim() == data.get('reviewNote', '')
          && data.get('revisionRequestedAt', null) == request.time
          && data.get('revisionRequestedBy', '') == request.auth.uid
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid;
      }

      function proClubStaffSubmissionValidApprovalV1(data, previous) {
        return proClubStaffSubmissionActorIsTechnicalAuthorityV1(clubId)
          && previous.get('schemaVersion', 0) == 1
          && previous.get('module', '') == 'TRAINING'
          && previous.get('authorUid', '') != request.auth.uid
          && previous.get('status', '') == 'IN_REVIEW'
          && previous.get('reviewerUid', '') == request.auth.uid
          && previous.get('reviewerRole', '')
            == proClubStaffSubmissionActorRoleV1(clubId)
          && data.get('status', '') == 'APPROVED'
          && data.diff(previous).affectedKeys().hasOnly([
            'status',
            'reviewNote',
            'approvedAt',
            'approvedBy',
            'updatedAt',
            'updatedBy'
          ])
          && data.get('reviewNote', null) is string
          && data.get('reviewNote', '').size() > 0
          && data.get('reviewNote', '').size() <= 2000
          && data.get('reviewNote', '').trim() == data.get('reviewNote', '')
          && data.get('approvedAt', null) == request.time
          && data.get('approvedBy', '') == request.auth.uid
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid;
      }

      function proClubStaffSubmissionValidUpdateV1(data, previous) {
        let fromStatus = previous.get('status', '');
        let toStatus = data.get('status', '');
        return fromStatus == toStatus
          ? proClubStaffSubmissionValidAuthorContentEditV1(data, previous)
          : (
            toStatus == 'SUBMITTED'
              ? proClubStaffSubmissionValidAuthorSubmitV1(data, previous)
              : (
                toStatus == 'IN_REVIEW'
                  ? proClubStaffSubmissionValidReviewStartV1(data, previous)
                  : (
                    toStatus == 'NEEDS_REVISION'
                      ? proClubStaffSubmissionValidRevisionRequestV1(
                        data,
                        previous
                      )
                      : (
                        toStatus == 'APPROVED'
                          && proClubStaffSubmissionValidApprovalV1(
                            data,
                            previous
                          )
                      )
                  )
              )
          );
      }

      // Pro Club Match + Starting XI Persistence V1 — Spark direct Firestore boundary.
      //
      // Child writes use compact trusted-state checks. Canonical Match writes
      // validate the full Match shape once; Starting XI / shootout then read one
      // Match-scoped roster index instead of issuing one exists() per player.
      function proClubMatchFootballAuthorityV1(clubId) {
        let userPath =
          /databases/$(database)/documents/users/$(request.auth.uid);
        let clubPath =
          /databases/$(database)/documents/proClubs/$(clubId);
        let membershipPath =
          /databases/$(database)/documents/proClubs/$(clubId)/members/$(request.auth.uid);
        let staffPath =
          /databases/$(database)/documents/proClubs/$(clubId)/staff/$(request.auth.uid);
        // Direct status/role reads imply document existence and fail closed
        // when any canonical authority document is missing.
        return isSignedIn()
          && get(userPath).data.get('status', '') in ['Active', 'ACTIVE']
          && get(clubPath).data.get('status', '') == 'ACTIVE'
          && get(membershipPath).data.get('status', '') == 'ACTIVE'
          && get(staffPath).data.get('status', '') == 'ACTIVE'
          && get(staffPath).data.get('staffRole', '')
            in ['HEAD_COACH', 'TECHNICAL_DIRECTOR'];
      }

      function proClubMatchActorRoleV1(clubId) {
        return get(
          /databases/$(database)/documents/proClubs/$(clubId)/staff/$(request.auth.uid)
        ).data.get('staffRole', '');
      }

      function proClubMatchOptionalTextV1(value, maxLength) {
        return value == null
          || (
            value is string
            && value.size() > 0
            && value.size() <= maxLength
            && value.trim() == value
          );
      }

      function proClubMatchCoreKeysV1(data) {
        return data.keys().hasAll([
            'schemaVersion',
            'status',
            'squadLabel',
            'competitionName',
            'opponentName',
            'kickoffAt',
            'venueType',
            'rosterPlayerKeys',
            'rosterRevision',
            'rosterMutationPlayerKey',
            'rosterMutationKind',
            'createdAt',
            'createdBy',
            'createdByRole',
            'updatedAt',
            'updatedBy',
            'updatedByRole'
          ])
          && data.keys().hasOnly([
            'schemaVersion',
            'status',
            'squadLabel',
            'competitionName',
            'opponentName',
            'kickoffAt',
            'venueType',
            'rosterPlayerKeys',
            'rosterRevision',
            'rosterMutationPlayerKey',
            'rosterMutationKind',
            'createdAt',
            'createdBy',
            'createdByRole',
            'updatedAt',
            'updatedBy',
            'updatedByRole'
          ]);
      }

      function proClubMatchRosterIndexStateV1(data) {
        let rosterPlayerKeys = data.get('rosterPlayerKeys', []);
        let rosterRevision = data.get('rosterRevision', -1);
        return data.get('schemaVersion', 0) == 1
          && rosterPlayerKeys is list
          && rosterPlayerKeys.size() <= 64
          && rosterPlayerKeys.toSet().size() == rosterPlayerKeys.size()
          && rosterRevision is int
          && rosterRevision >= 0;
      }

      function proClubMatchValidDataV1(data) {
        let status = data.get('status', '');
        return proClubMatchCoreKeysV1(data)
          && proClubMatchRosterIndexStateV1(data)
          && status in [
            'DRAFT',
            'SCHEDULED',
            'IN_PROGRESS',
            'COMPLETED',
            'CANCELLED'
          ]
          && data.get('squadLabel', '') is string
          && data.get('squadLabel', '').size() > 0
          && data.get('squadLabel', '').size() <= 80
          && data.get('squadLabel', '').trim()
            == data.get('squadLabel', '')
          && data.get('competitionName', '') is string
          && data.get('competitionName', '').size() > 0
          && data.get('competitionName', '').size() <= 120
          && data.get('competitionName', '').trim()
            == data.get('competitionName', '')
          && proClubMatchOptionalTextV1(
            data.get('opponentName', null),
            120
          )
          && (
            status in ['DRAFT', 'CANCELLED']
              ? (
                (
                  data.get('kickoffAt', null) == null
                  || data.get('kickoffAt', null) is timestamp
                )
                && (
                  data.get('venueType', null) == null
                  || data.get('venueType', '')
                    in ['HOME', 'AWAY', 'NEUTRAL']
                )
              )
              : (
                data.get('opponentName', null) is string
                && data.get('opponentName', '').size() > 0
                && data.get('kickoffAt', null) is timestamp
                && data.get('venueType', '')
                  in ['HOME', 'AWAY', 'NEUTRAL']
              )
          )
          && (
            data.get('rosterRevision', -1) == 0
              ? (
                data.get('rosterPlayerKeys', []).size() == 0
                && data.get('rosterMutationPlayerKey', null) == null
                && data.get('rosterMutationKind', null) == null
              )
              : (
                data.get('rosterMutationPlayerKey', null) is string
                && data.get('rosterMutationPlayerKey', '').size() > 0
                && data.get('rosterMutationKind', '') in ['ADD', 'REMOVE']
              )
          )
          && data.get('createdAt', null) is timestamp
          && data.get('createdBy', null) is string
          && data.get('createdByRole', '')
            in ['HEAD_COACH', 'TECHNICAL_DIRECTOR']
          && data.get('updatedAt', null) is timestamp
          && data.get('updatedBy', null) is string
          && data.get('updatedByRole', '')
            in ['HEAD_COACH', 'TECHNICAL_DIRECTOR'];
      }

      function proClubMatchValidTransitionV1(fromStatus, toStatus) {
        return (
            fromStatus == toStatus
            && fromStatus in ['DRAFT', 'SCHEDULED', 'IN_PROGRESS']
          )
          || (
            fromStatus == 'DRAFT'
            && toStatus in ['SCHEDULED', 'CANCELLED']
          )
          || (
            fromStatus == 'SCHEDULED'
            && toStatus in ['IN_PROGRESS', 'CANCELLED']
          )
          || (
            fromStatus == 'IN_PROGRESS'
            && toStatus in ['COMPLETED', 'CANCELLED']
          );
      }

      function proClubMatchRosterIndexUnchangedV1(data, previous) {
        return data.get('rosterPlayerKeys', [])
            == previous.get('rosterPlayerKeys', [])
          && data.get('rosterRevision', -1)
            == previous.get('rosterRevision', -1)
          && data.get('rosterMutationPlayerKey', null)
            == previous.get('rosterMutationPlayerKey', null)
          && data.get('rosterMutationKind', null)
            == previous.get('rosterMutationKind', null);
      }

      function proClubMatchPlansReferencePlayerV1(matchId, playerKey) {
        let startingPath =
          /databases/$(database)/documents/proClubs/$(clubId)/matches/$(matchId)/startingXI/current;
        let shootoutPath =
          /databases/$(database)/documents/proClubs/$(clubId)/matches/$(matchId)/shootout/current;
        return (
            exists(startingPath)
            && (
              get(startingPath).data.get('slotPlayerKeys', [])
                .hasAny([playerKey])
              || get(startingPath).data.get('substitutePlayerKeys', [])
                .hasAny([playerKey])
            )
          )
          || (
            exists(shootoutPath)
            && (
              get(shootoutPath).data.get('primaryTakers', [])
                .hasAny([playerKey])
              || get(shootoutPath).data.get('backupTakers', [])
                .hasAny([playerKey])
            )
          );
      }

      function proClubMatchValidRosterIndexMutationV1(
        matchId,
        data,
        previous
      ) {
        let playerKey = data.get('rosterMutationPlayerKey', '');
        let mutationKind = data.get('rosterMutationKind', '');
        let rosterPath =
          /databases/$(database)/documents/proClubs/$(clubId)/matches/$(matchId)/roster/$(playerKey);
        return previous.get('status', '') in ['DRAFT', 'SCHEDULED']
          && data.get('status', '') == previous.get('status', '')
          && data.diff(previous).affectedKeys().hasOnly([
            'rosterPlayerKeys',
            'rosterRevision',
            'rosterMutationPlayerKey',
            'rosterMutationKind',
            'updatedAt',
            'updatedBy',
            'updatedByRole'
          ])
          && playerKey.size() > 0
          && data.get('rosterRevision', -1)
            == previous.get('rosterRevision', -1) + 1
          && (
            mutationKind == 'ADD'
              ? (
                !previous.get('rosterPlayerKeys', []).hasAny([playerKey])
                && data.get('rosterPlayerKeys', [])
                  == previous.get('rosterPlayerKeys', []).concat([playerKey])
                && existsAfter(rosterPath)
                && getAfter(rosterPath).data.get('playerKey', '') == playerKey
              )
              : (
                mutationKind == 'REMOVE'
                && previous.get('rosterPlayerKeys', []).hasAny([playerKey])
                && data.get('rosterPlayerKeys', [])
                  == previous.get('rosterPlayerKeys', []).removeAll([playerKey])
                && !existsAfter(rosterPath)
                && !proClubMatchPlansReferencePlayerV1(matchId, playerKey)
              )
          );
      }

      function proClubMatchValidCreateV1(matchId) {
        let data = request.resource.data;
        let actorRole = proClubMatchActorRoleV1(clubId);
        return proClubMatchFootballAuthorityV1(clubId)
          && matchId.size() > 0
          && proClubMatchValidDataV1(data)
          && data.get('status', '') == 'DRAFT'
          && data.get('rosterRevision', -1) == 0
          && data.get('createdAt', null) == request.time
          && data.get('createdBy', '') == request.auth.uid
          && data.get('createdByRole', '') == actorRole
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid
          && data.get('updatedByRole', '') == actorRole;
      }

      function proClubMatchValidUpdateV1(matchId) {
        let data = request.resource.data;
        let previous = resource.data;
        let actorRole = proClubMatchActorRoleV1(clubId);
        return proClubMatchFootballAuthorityV1(clubId)
          && matchId.size() > 0
          && previous.get('schemaVersion', 0) == 1
          && proClubMatchValidDataV1(data)
          && proClubMatchValidTransitionV1(
            previous.get('status', ''),
            data.get('status', '')
          )
          && data.get('createdAt', null)
            == previous.get('createdAt', null)
          && data.get('createdBy', '')
            == previous.get('createdBy', '')
          && data.get('createdByRole', '')
            == previous.get('createdByRole', '')
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid
          && data.get('updatedByRole', '') == actorRole
          && (
            proClubMatchRosterIndexUnchangedV1(data, previous)
            || proClubMatchValidRosterIndexMutationV1(
              matchId,
              data,
              previous
            )
          );
      }

      function proClubMatchRosterSnapshotKeysV1(data) {
        return data.keys().hasAll([
            'schemaVersion',
            'playerKey',
            'futId',
            'firstName',
            'lastName',
            'jerseyNumber',
            'position',
            'additionalPositions',
            'createdAt',
            'createdBy',
            'createdByRole',
            'updatedAt',
            'updatedBy',
            'updatedByRole'
          ])
          && data.keys().hasOnly([
            'schemaVersion',
            'playerKey',
            'futId',
            'firstName',
            'lastName',
            'jerseyNumber',
            'position',
            'additionalPositions',
            'createdAt',
            'createdBy',
            'createdByRole',
            'updatedAt',
            'updatedBy',
            'updatedByRole'
          ]);
      }

      function proClubMatchValidRosterSnapshotDataV1(playerKey, data) {
        let playerPath =
          /databases/$(database)/documents/proClubs/$(clubId)/players/$(playerKey);
        let player = get(playerPath).data;
        return playerKey.size() > 0
          && exists(playerPath)
          && player.get('status', '') == 'ACTIVE'
          && proClubMatchRosterSnapshotKeysV1(data)
          && data.get('schemaVersion', 0) == 1
          && data.get('playerKey', '') == playerKey
          && data.get('futId', null) == player.get('futId', null)
          && data.get('firstName', '') == player.get('firstName', '')
          && data.get('lastName', '') == player.get('lastName', '')
          && data.get('jerseyNumber', -1)
            == player.get('jerseyNumber', -1)
          && data.get('position', null)
            == player.get('position', null)
          && data.get('additionalPositions', [])
            == player.get('additionalPositions', []);
      }

      function proClubMatchValidRosterSnapshotCreateV1(
        matchId,
        playerKey
      ) {
        let data = request.resource.data;
        let matchPath =
          /databases/$(database)/documents/proClubs/$(clubId)/matches/$(matchId);
        let matchAfter = getAfter(matchPath).data;
        let actorRole = proClubMatchActorRoleV1(clubId);
        return proClubMatchFootballAuthorityV1(clubId)
          && proClubMatchValidRosterSnapshotDataV1(playerKey, data)
          && proClubMatchRosterIndexStateV1(matchAfter)
          && matchAfter.get('status', '') in ['DRAFT', 'SCHEDULED']
          && matchAfter.get('rosterMutationKind', '') == 'ADD'
          && matchAfter.get('rosterMutationPlayerKey', '') == playerKey
          && matchAfter.get('rosterPlayerKeys', []).hasAny([playerKey])
          && data.get('createdAt', null) == request.time
          && data.get('createdBy', '') == request.auth.uid
          && data.get('createdByRole', '') == actorRole
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid
          && data.get('updatedByRole', '') == actorRole;
      }

      function proClubMatchValidRosterSnapshotDeleteV1(
        matchId,
        playerKey
      ) {
        let matchPath =
          /databases/$(database)/documents/proClubs/$(clubId)/matches/$(matchId);
        let matchAfter = getAfter(matchPath).data;
        return proClubMatchFootballAuthorityV1(clubId)
          && resource.data.get('schemaVersion', 0) == 1
          && resource.data.get('playerKey', '') == playerKey
          && proClubMatchRosterIndexStateV1(matchAfter)
          && matchAfter.get('status', '') in ['DRAFT', 'SCHEDULED']
          && matchAfter.get('rosterMutationKind', '') == 'REMOVE'
          && matchAfter.get('rosterMutationPlayerKey', '') == playerKey
          && !matchAfter.get('rosterPlayerKeys', []).hasAny([playerKey]);
      }

      function proClubMatchValidSetPiecesV1(assignments, selected) {
        let assignedPlayerKeys = assignments.values().removeAll([null]);
        return assignments is map
          && assignments.keys().size() == 7
          && assignments.keys().hasOnly([
            'CORNER_LEFT',
            'CORNER_RIGHT',
            'FREE_KICK_LEFT',
            'FREE_KICK_RIGHT',
            'THROW_IN_LEFT',
            'THROW_IN_RIGHT',
            'PENALTY'
          ])
          && selected.hasAll(assignedPlayerKeys);
      }

      function proClubMatchValidRoleAssignmentV1(value) {
        return value == null
          || (
            value is string
            && value.size() > 0
            && value.size() <= 160
            && value.trim() == value
          );
      }

      function proClubMatchValidRoleAssignmentsV1(roles) {
        return roles is list
          && roles.size() == 11
          && proClubMatchValidRoleAssignmentV1(roles[0])
          && proClubMatchValidRoleAssignmentV1(roles[1])
          && proClubMatchValidRoleAssignmentV1(roles[2])
          && proClubMatchValidRoleAssignmentV1(roles[3])
          && proClubMatchValidRoleAssignmentV1(roles[4])
          && proClubMatchValidRoleAssignmentV1(roles[5])
          && proClubMatchValidRoleAssignmentV1(roles[6])
          && proClubMatchValidRoleAssignmentV1(roles[7])
          && proClubMatchValidRoleAssignmentV1(roles[8])
          && proClubMatchValidRoleAssignmentV1(roles[9])
          && proClubMatchValidRoleAssignmentV1(roles[10]);
      }

      function proClubGameModelPhasesValidV1(phases) {
        return phases is map
          && phases.keys().size() == 4
          && phases.keys().hasOnly([
            'IN_POSSESSION',
            'OUT_OF_POSSESSION',
            'TRANSITION_TO_ATTACK',
            'TRANSITION_TO_DEFEND'
