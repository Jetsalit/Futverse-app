          )
          && data.get('matchRosterRevision', -1)
            == matchData.get('rosterRevision', -2)
          && data.get('revision', 0)
            == previous.get('revision', 0) + 1
          && data.get('createdAt', null)
            == previous.get('createdAt', null)
          && data.get('createdBy', '')
            == previous.get('createdBy', '')
          && data.get('createdByRole', '')
            == previous.get('createdByRole', '')
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid
          && data.get('updatedByRole', '') == actorRole;
      }

            // Pro Club Attendance V1 — Spark direct Firestore boundary.
      function proClubAttendanceValidSessionKeysV1(data) {
        return data.keys().hasAll([
            'schemaVersion', 'sessionDate', 'startTime', 'squadLabel',
            'sessionType', 'createdAt', 'createdBy'
          ])
          && data.keys().hasOnly([
            'schemaVersion', 'sessionDate', 'startTime', 'squadLabel',
            'sessionType', 'createdAt', 'createdBy'
          ]);
      }

      function proClubAttendanceSessionIdMatchesV1(attendanceSessionId, data) {
        return attendanceSessionId
          == 'training_' + data.get('sessionDate', '')
            + '_' + data.get('startTime', '').replace(':', '-');
      }

      function proClubAttendanceValidSessionDataV1(attendanceSessionId, data) {
        return exactDocumentId(attendanceSessionId)
          && proClubAttendanceValidSessionKeysV1(data)
          && data.get('schemaVersion', 0) == 1
          && proClubWeeklyTrainingStrictCalendarDateV1(data.get('sessionDate', ''))
          && data.get('startTime', '') is string
          && data.get('startTime', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && proClubAttendanceSessionIdMatchesV1(attendanceSessionId, data)
          && data.get('squadLabel', '') == 'First Team'
          && data.get('sessionType', '') == 'TRAINING'
          && data.get('createdAt', null) is timestamp
          && exactDocumentId(data.get('createdBy', ''));
      }

      function proClubAttendanceValidSessionCreateV1(attendanceSessionId) {
        let data = request.resource.data;
        return proClubSquadRosterActiveHeadCoachV1(clubId)
          && proClubAttendanceValidSessionDataV1(attendanceSessionId, data)
          && data.get('createdAt', null) == request.time
          && data.get('createdBy', '') == request.auth.uid;
      }

      function proClubAttendanceValidRecordKeysV1(data) {
        return data.keys().hasAll([
            'schemaVersion', 'status', 'createdAt', 'createdBy',
            'updatedAt', 'updatedBy'
          ])
          && data.keys().hasOnly([
            'schemaVersion', 'status', 'createdAt', 'createdBy',
            'updatedAt', 'updatedBy'
          ]);
      }

      function proClubAttendanceValidStatusV1(status) {
        return status in ['PRESENT', 'LATE', 'ABSENT', 'EXCUSED'];
      }

      function proClubAttendanceSessionExistsV1(attendanceSessionId) {
        let sessionPath =
          /databases/$(database)/documents/proClubs/$(clubId)/attendanceSessions/$(attendanceSessionId);
        return exists(sessionPath)
          && proClubAttendanceValidSessionDataV1(
            attendanceSessionId,
            get(sessionPath).data
          );
      }

      function proClubAttendanceRosterEligibleV1(playerKey) {
        let playerPath =
          /databases/$(database)/documents/proClubs/$(clubId)/players/$(playerKey);
        let player = get(playerPath).data;
        return validPlayerIdentityKeyV1(playerKey)
          && exists(playerPath)
          && proClubSquadRosterHasCanonicalKeysV1(player)
          && player.get('schemaVersion', 0) == 1
          && player.get('status', '') == 'ACTIVE'
          && player.get('squadLabel', '') == 'First Team';
      }

      function proClubAttendanceValidRecordDataV1(playerKey, data) {
        return validPlayerIdentityKeyV1(playerKey)
          && proClubAttendanceValidRecordKeysV1(data)
          && data.get('schemaVersion', 0) == 1
          && proClubAttendanceValidStatusV1(data.get('status', ''))
          && data.get('createdAt', null) is timestamp
          && exactDocumentId(data.get('createdBy', ''))
          && data.get('updatedAt', null) is timestamp
          && exactDocumentId(data.get('updatedBy', ''));
      }

      function proClubAttendanceValidRecordCreateV1(
        attendanceSessionId,
        playerKey
      ) {
        let data = request.resource.data;
        return proClubSquadRosterActiveHeadCoachV1(clubId)
          && proClubAttendanceSessionExistsV1(attendanceSessionId)
          && proClubAttendanceRosterEligibleV1(playerKey)
          && proClubAttendanceValidRecordDataV1(playerKey, data)
          && data.get('createdAt', null) == request.time
          && data.get('createdBy', '') == request.auth.uid
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid;
      }

      function proClubAttendanceValidRecordUpdateV1(
        attendanceSessionId,
        playerKey
      ) {
        let data = request.resource.data;
        let previous = resource.data;
        return proClubSquadRosterActiveHeadCoachV1(clubId)
          && proClubAttendanceSessionExistsV1(attendanceSessionId)
          && proClubAttendanceValidRecordDataV1(playerKey, previous)
          && proClubAttendanceValidRecordDataV1(playerKey, data)
          && data.diff(previous).affectedKeys().hasOnly([
            'status', 'updatedAt', 'updatedBy'
          ])
          && data.get('createdAt', null) == previous.get('createdAt', null)
          && data.get('createdBy', '') == previous.get('createdBy', '')
          && data.get('updatedAt', null) == request.time
          && data.get('updatedBy', '') == request.auth.uid;
      }

      allow get: if isSignedIn()
        && exists(
          /databases/$(database)/documents/proClubs/$(clubId)/members/$(request.auth.uid)
        );

      allow list, create, update, delete: if false;

      // Pro Club Game Model V1 — one editable four-phase master per club.
      match /gameModel/current {
        allow get: if proClubSquadRosterActiveStaffV1(clubId);
        allow list: if false;
        allow create: if proClubGameModelValidCreateV1();
        allow update: if proClubGameModelValidUpdateV1();
        allow delete: if false;
      }

      // Pro Club Match + Starting XI Persistence V1 — canonical tenant path.
      match /matches/{matchId} {
        allow get, list: if proClubSquadRosterActiveStaffV1(clubId);
        allow create: if proClubMatchValidCreateV1(matchId);
        allow update: if proClubMatchValidUpdateV1(matchId);
        allow delete: if false;

        match /roster/{playerKey} {
          allow get, list: if proClubSquadRosterActiveStaffV1(clubId);
          allow create: if proClubMatchValidRosterSnapshotCreateV1(
            matchId,
            playerKey
          );
          allow update: if false;
          allow delete: if proClubMatchValidRosterSnapshotDeleteV1(
            matchId,
            playerKey
          );

          match /{document=**} {
            allow read, write: if false;
          }
        }

        match /startingXI/current {
          allow get: if proClubSquadRosterActiveStaffV1(clubId);
          allow list: if false;
          // Keep authority as an outer short-circuit so unauthorized writes
          // never enter the larger Starting XI contract validator.
          allow create: if proClubMatchFootballAuthorityV1(clubId)
            && proClubMatchValidStartingXICreateV1(matchId);
          allow update: if proClubMatchFootballAuthorityV1(clubId)
            && proClubMatchValidStartingXIUpdateV1(matchId);
          allow delete: if false;
        }

        match /shootout/current {
          allow get: if proClubSquadRosterActiveStaffV1(clubId);
          allow list: if false;
          allow create: if proClubMatchValidShootoutCreateV1(matchId);
          allow update: if proClubMatchValidShootoutUpdateV1(matchId);
          allow delete: if false;
        }

        // Audit persistence remains closed in this Rules slice. The canonical
        // path is reserved now so no alternate client-owned audit path appears.
        match /startingXIAudit/{eventId} {
          allow get, list: if proClubSquadRosterActiveStaffV1(clubId);
          allow create, update, delete: if false;
        }

        match /{document=**} {
          allow read, write: if false;
        }
      }

      // Pro Club Attendance V1 — canonical training attendance path.
      match /attendanceSessions/{attendanceSessionId} {
        allow get, list: if proClubSquadRosterActiveStaffV1(clubId);
        allow create: if proClubAttendanceValidSessionCreateV1(
          attendanceSessionId
        );
        allow update, delete: if false;

        match /records/{playerKey} {
          allow get, list: if proClubSquadRosterActiveStaffV1(clubId);
          allow create: if proClubAttendanceValidRecordCreateV1(
            attendanceSessionId,
            playerKey
          );
          allow update: if proClubAttendanceValidRecordUpdateV1(
            attendanceSessionId,
            playerKey
          );
          allow delete: if false;
        }

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /members/{uid} {
        allow get: if isSignedIn()
          && request.auth.uid == uid;
        allow list: if false;
        allow create: if validProClubMembershipCreateV1(clubId, uid);
        allow update, delete: if false;
      }

      match /staff/{uid} {
        allow get: if isSignedIn()
          && request.auth.uid == uid;
        allow list: if false;
        allow create: if validProClubStaffCreateV1(clubId, uid);
        allow update, delete: if false;
      }

      // Name history is append-only and written only by the trusted Admin SDK
      // transaction. ACTIVE OWNER/ADMIN reviewers may read it for audit use.
      match /nameHistory/{changeId} {
        allow get, list: if isActiveProClubReviewerV1(clubId);
        allow create, update, delete: if false;
      }

      match /onboardingClaims/{claimId} {
        allow get: if isSignedIn()
          && (
            resource.data.get('userId', '') == request.auth.uid
            || isActiveProClubReviewerV1(clubId)
            || isSuperAdmin()
          );
        // Queries must constrain both fields; Rules do not filter results.
        // Authority comes from this exact tenant path, never users.role.
        allow list: if (
            isActiveProClubReviewerV1(clubId)
            || isSuperAdmin()
          )
          && resource.data.clubId == clubId
          && resource.data.status == 'PENDING';
        allow create: if validProClubClaimCreateV1(clubId, claimId);
        allow update: if resource != null
          && (
            request.resource.data.get('status', '') == 'APPROVED'
              ? validProClubClaimApprovalV1(clubId, claimId)
              : (
                request.resource.data.get('status', '') == 'REJECTED'
                && validProClubClaimRejectionV1(clubId, claimId)
              )
          );
        allow delete: if false;
      }

      match /onboardingApprovals/{uid} {
        allow get: if isSignedIn()
          && (
            request.auth.uid == uid
            || isActiveProClubReviewerV1(clubId)
            || isSuperAdmin()
          );
        allow list: if false;
        allow create: if isSuperAdmin()
          ? validProClubSuperAdminApprovalProofCreateV1(clubId, uid)
          : validProClubApprovalProofCreateV1(clubId, uid);
        allow update, delete: if false;
      }

      // Pro Club Staff Submissions V1 — no delete; technical approval remains
      // bound to technicalGovernance/current rather than OWNER/ADMIN membership.
      match /staffSubmissions/{submissionId} {
        allow get: if exactDocumentId(submissionId)
          && (
            (
              proClubStaffSubmissionActiveAuthorV1(clubId)
              && resource.data.get('authorUid', '') == request.auth.uid
            )
            || proClubStaffSubmissionActorIsTechnicalAuthorityV1(clubId)
          );

        // Author lists require an authorUid == request.auth.uid query constraint.
        // Exact technical authority may list the tenant review inbox.
        allow list: if (
            proClubStaffSubmissionActiveAuthorV1(clubId)
            && resource.data.authorUid == request.auth.uid
          )
          || proClubStaffSubmissionActorIsTechnicalAuthorityV1(clubId);

        allow create: if exactDocumentId(submissionId)
          && proClubStaffSubmissionValidCreateV1(request.resource.data);

        allow update: if exactDocumentId(submissionId)
          && resource != null
          && proClubStaffSubmissionValidUpdateV1(
            request.resource.data,
            resource.data
          );

        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      // Pro Club Player Photo V1 — compact profile image stored separately
      // from the frozen canonical roster document.
      match /playerPhotos/{playerKey} {
        allow get, list: if proClubSquadRosterActiveStaffV1(clubId);
        allow create: if proClubPlayerPhotoValidCreateV1(clubId, playerKey);
        allow update: if proClubPlayerPhotoValidUpdateV1(clubId, playerKey);
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      // Pro Club Squad Roster V1 — canonical tenant roster path.
      match /players/{playerKey} {
        allow get, list: if proClubSquadRosterActiveStaffV1(clubId);
        allow create: if proClubSquadRosterValidCreateV1(clubId, playerKey);
        allow update: if proClubSquadRosterValidUpdateV1(clubId, playerKey);
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      // Pro Club Fitness Results V1 — immutable player observations.
      function proClubFitnessResultPlayerEligibleV1(playerKey) {
        let playerPath =
          /databases/$(database)/documents/proClubs/$(clubId)/players/$(playerKey);
        return validPlayerIdentityKeyV1(playerKey)
          && exists(playerPath)
          && get(playerPath).data.get('status', '') in ['ACTIVE', 'INACTIVE'];
      }

      function proClubFitnessResultIdentitySeedV1(data) {
        return 'fitness-result-v1|'
          + string(data.playerKey.toUtf8().size())
          + ':'
          + data.playerKey
          + '|'
          + data.observedOn
          + '|'
          + string(data.definitionId.toUtf8().size())
          + ':'
          + data.definitionId
          + '|'
          + string(data.definitionVersion);
      }

      function proClubFitnessResultIdMatchesV1(resultId, data) {
        return resultId == 'fit-v1-'
          + hashing.sha256(
            proClubFitnessResultIdentitySeedV1(data)
          ).toHexString().lower();
      }

      function proClubFitnessResultValidCreateV1(resultId) {
        let data = request.resource.data;
        let staffPath =
          /databases/$(database)/documents/proClubs/$(clubId)/staff/$(request.auth.uid);
        return proClubSquadRosterActiveStaffV1(clubId)
          && get(staffPath).data.get('staffRole', '') == 'FITNESS_COACH'
          && exactDocumentId(resultId)
          && data.keys().hasAll([
            'schemaVersion',
            'playerKey',
            'definitionId',
            'definitionVersion',
            'value',
            'observedOn',
            'source',
            'recordedAt',
            'recordedBy'
          ])
          && data.keys().hasOnly([
            'schemaVersion',
            'playerKey',
            'definitionId',
            'definitionVersion',
            'value',
            'observedOn',
            'source',
            'recordedAt',
            'recordedBy'
          ])
          && data.get('schemaVersion', 0) == 1
          && proClubFitnessResultPlayerEligibleV1(
            data.get('playerKey', '')
          )
          && validAcademyFitnessDefinitionIdV1(
            data.get('definitionId', '')
          )
          && data.get('definitionVersion', 0) is int
          && data.get('definitionVersion', 0) > 0
          && validAcademyFitnessResultValueV1(
            data.get('value', null)
          )
          && validAcademyFitnessObservedOnV1(
            data.get('observedOn', '')
          )
          && data.get('source', '') == 'PRO_CLUB_FITNESS_ENTRY'
          && data.get('recordedAt', null) is timestamp
          && data.get('recordedAt', null) == request.time
          && exactDocumentId(data.get('recordedBy', ''))
          && data.get('recordedBy', '') == request.auth.uid
          && proClubFitnessResultIdMatchesV1(resultId, data);
      }

      match /fitnessResults/{resultId} {
        allow get, list: if proClubSquadRosterActiveStaffV1(clubId);
        allow create: if proClubFitnessResultValidCreateV1(resultId);
        allow update, delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /proPlayers/{proPlayerId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && hasNoStoredDocumentId();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /scoutPlayers/{scoutPlayerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && hasNoStoredDocumentId()
        && request.resource.data.get('submittedBy', '') == request.auth.uid
        && (
          isAdmin()
          || (
            request.resource.data.get('status', '') == 'Pending'
            && request.resource.data.get('grade', '') == 'C'
            && request.resource.data.get('stars', 0) == 3
          )
        );
      allow update: if isAdmin()
        && hasNoStoredDocumentId()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'submittedBy'
        ]);
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
