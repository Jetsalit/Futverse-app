rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }

    function isSuperAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPERADMIN';
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPERADMIN', 'ADMIN'];
    }

    function isTenantAdmin(academyId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && user.role == 'ADMIN' && user.academyId == academyId;
    }

    function belongsToAcademy(academyId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && (user.academyId == academyId || isSuperAdmin() || user.role == 'PARENT');
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if false;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /academies/{academyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      // ============================================================
      // OBSERVATION ENGINE (Rev 3.9.2) - Tenant Collections
      // ============================================================
      match /observation_profiles/{profileId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if isSuperAdmin() || isTenantAdmin(academyId);
      }
      
      match /observation_sessions/{sessionId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if belongsToAcademy(academyId);
      }
      
      match /observation_live_events/{eventId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if belongsToAcademy(academyId);
      }
      
      match /observation_reflections/{reflectionId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if belongsToAcademy(academyId);
      }

      // Legacy fallback
      match /{collection}/{document=**} {
        allow read: if isSignedIn();
        // Prevent wildcard from bypassing strict observation rules
        allow write: if isSignedIn() && !(collection in ['observation_profiles', 'observation_sessions', 'observation_live_events', 'observation_reflections']);
      }
    }
    
    match /coaches/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /logs/{document=**} {
      allow read: if isSuperAdmin();
      allow create: if true;
    }
    
    match /players/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /drills/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /proPlayers/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /scoutPlayers/{document=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isAdmin();
    }
    
    match /evaluation_criteria/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isAdmin() || isSignedIn();
    }
    
    match /player_evaluations/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /fitness_tests/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /profile_claims/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /notifications/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /parent_observation_metrics/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    
    match /parent_match_observations/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ============================================================
    // OBSERVATION ENGINE (Rev 3.8) - New Collections
    // ============================================================
    match /observation_metrics/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
