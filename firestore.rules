      function proClubMatchValidShootoutUpdateV1(matchId) {
        let data = request.resource.data;
        let previous = resource.data;
        let matchPath =
          /databases/$(database)/documents/proClubs/$(clubId)/matches/$(matchId);
        let matchData = get(matchPath).data;
