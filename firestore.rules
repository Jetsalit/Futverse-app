    function validProClubInviteCreateV1(inviteCode) {
      let data = request.resource.data;
      let clubId = data.get('clubId', '');
      let targetUid = data.get('targetUid', '');

      return isSignedIn()
        && exactDocumentId(clubId)
        && exactDocumentId(targetUid)
        && validProClubInviteCodeV1(inviteCode)
        && data.get('inviteCode', '') == inviteCode
        && isProClubOnboardingControlActorV1(clubId)
        && userExists(targetUid)
        && (
          !isSuperAdmin()
          || (
            proClubSuperAdminInviteTargetIsEligibleV1(targetUid)
            && matchingProClubOnboardingControlAuditAfterV1(
              'INVITE-' + inviteCode,
              'INVITE_ISSUED',
              clubId,
              targetUid,
              inviteCode,
              null,
              data.get('staffRole', '')
            )
          )
        )
        && data.keys().hasOnly([
          'schemaVersion',
          'inviteCode',
          'clubId',
          'targetUid',
          'membershipAuthorizationRole',
          'staffRole',
          'createdAt',
          'createdBy',
          'expiresAt',
          'status',
          'updatedAt',
          'updatedBy'
        ])
        && data.get('schemaVersion', 0) == 1
        && data.get('membershipAuthorizationRole', '') == 'MEMBER'
        && validProClubStaffRoleV1(data.get('staffRole', ''))
        && data.get('status', '') == 'ACTIVE'
        && data.get('createdAt', null) is timestamp
        && data.get('createdAt', null) == request.time
        && data.get('createdBy', '') == request.auth.uid
        && data.get('updatedAt', null) is timestamp
        && data.get('updatedAt', null) == request.time
        && data.get('updatedBy', '') == request.auth.uid
        && data.get('expiresAt', null) is timestamp
        && data.get('expiresAt', null) > request.time
        && data.get('expiresAt', null)
          <= request.time + duration.value(7, 'd')
        && !exists(
          /databases/$(database)/documents/proClubs/$(clubId)/members/$(targetUid)
        )
        && !exists(
          /databases/$(database)/documents/proClubs/$(clubId)/staff/$(targetUid)
        )
        && !exists(
          /databases/$(database)/documents/proClubs/$(clubId)/onboardingApprovals/$(targetUid)
        )
        && !exists(
          /databases/$(database)/documents/proClubs/$(clubId)/onboardingClaims/$(targetUid + '_PRO_CLUB_' + inviteCode)
        );
    }
    function proClubIdentityTextV1(value) {
      return value is string && value.matches('[\\s\\S]*\\S[\\s\\S]*');
    }

    function validProClubClaimantIdentityV1(identity) {
      return identity is map
        && identity.keys().hasOnly(['displayName', 'email'])
        && identity.keys().size() > 0
        && (!identity.keys().hasAny(['displayName'])
          || proClubIdentityTextV1(identity.displayName))
        && (!identity.keys().hasAny(['email'])
          || proClubIdentityTextV1(identity.email));
    }

    function proClubClaimantIdentityMatchesUserV1(identity) {
      let user = currentUserData();
      return validProClubClaimantIdentityV1(identity)
        && (proClubIdentityTextV1(user.get('name', ''))
          ? identity.get('displayName', null) == user.name
          : !identity.keys().hasAny(['displayName']))
        && (proClubIdentityTextV1(user.get('email', ''))
          ? identity.get('email', null) == user.email
          : !identity.keys().hasAny(['email']));
    }

