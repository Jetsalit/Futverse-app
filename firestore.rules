rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && userExists(request.auth.uid)
        && currentUserData().get('role', '') == 'SUPERADMIN';
    }

    function isOwnUserDocument(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function currentActiveAcademyId() {
      return currentUserData().get('activeAcademyId', '');
    }

    function validInviteCode(inviteCode) {
      return inviteCode is string
        && inviteCode.size() <= 32
        && inviteCode.matches('^FUT-[A-Z0-9-]+$');
    }

    function exactDocumentId(value) {
      return value is string
        && value.size() > 0
        && value.matches('^[^/]+$');
    }

    function activeInviteMatchesAcademy(inviteCode, academyId) {
      return validInviteCode(inviteCode)
        && exactDocumentId(academyId)
        && exists(
          /databases/$(database)/documents/academy_invites/$(inviteCode)
        )
        && get(
          /databases/$(database)/documents/academy_invites/$(inviteCode)
        ).data.get('inviteCode', '') == inviteCode
        && get(
          /databases/$(database)/documents/academy_invites/$(inviteCode)
        ).data.get('academyId', '') == academyId
        && get(
          /databases/$(database)/documents/academy_invites/$(inviteCode)
        ).data.get('status', '') == 'ACTIVE';
    }

    function isActiveAcademyMember(academyId) {
      let membership = get(
        /databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)
      ).data;
      return isSignedIn()
        && userExists(request.auth.uid)
        && exists(
          /databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)
        )
        && membership.get('userId', '') == request.auth.uid
        && membership.get('academyId', '') == academyId
        && membership.get('status', '') == 'ACTIVE'
        && membership.get('role', '') in ['ADMIN', 'COACH'];
    }

    function hasAcademyRole(academyId, roles) {
      return isActiveAcademyMember(academyId)
        && get(
          /databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)
        ).data.role in roles;
    }

    function safeOwnerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'displayName',
        'photoURL',
        'country',
        'phone',
        'lastLogin',
        'updatedAt',
        'pdpaAccepted',
        'pdpaAcceptedAt'
      ]);
    }

    function validRegistrationUser(uid) {
      return request.resource.data.get('uid', '') == uid
        && request.resource.data.get('academyId', null) == null
        && request.resource.data.get('activeAcademyId', null) == null
        && request.resource.data.get('tenantRole', null) == null
        && request.resource.data.get('subscriptionPlan', 'FREE') == 'FREE'
        && !request.resource.data.keys().hasAny([
          'maxPlayers',
          'paymentDetails'
        ])
        && request.resource.data.get('role', '') in ['USER', 'PLAYER']
        && (
          (
            request.resource.data.role == 'USER'
            && request.resource.data.get('status', '') == 'Inactive'
          )
          || (
            request.resource.data.role == 'PLAYER'
            && request.resource.data.get('status', '') == 'Active'
          )
        );
    }

    function userPointerUpdateMatchesActiveMembership(uid) {
      let academyId = request.resource.data.get('activeAcademyId', '');
      let membership = get(
        /databases/$(database)/documents/academies/$(academyId)/members/$(uid)
      ).data;
      let claimId = membership.get('approvalClaimId', '');
      return academyId != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeAcademyId',
          'academyId',
          'tenantRole',
          'role',
          'status',
          'updatedAt'
        ])
        && exists(
          /databases/$(database)/documents/academies/$(academyId)/members/$(uid)
        )
        && membership.get('status', '') == 'ACTIVE'
        && membership.get('userId', '') == uid
        && membership.get('academyId', '') == academyId
        && membership.get('role', '') in ['ADMIN', 'COACH']
        && membership.get('source', '') == 'CLAIM_APPROVAL'
        && exactDocumentId(claimId)
        && exists(
          /databases/$(database)/documents/profile_claims/$(claimId)
        )
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get('status', '') == 'APPROVED'
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get('userId', '') == uid
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get('approvedAcademyId', '') == academyId
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get('approvedRole', '') == membership.get('role', '')
        && activeInviteMatchesAcademy(
          get(
            /databases/$(database)/documents/profile_claims/$(claimId)
          ).data.get('inviteCode', ''),
          academyId
        )
        && get(
          /databases/$(database)/documents/profile_claims/$(claimId)
        ).data.get(
          'requestedAcademyId',
          academyId
        ) == academyId
        && request.resource.data.get('academyId', '') == academyId
        && request.resource.data.get('tenantRole', '') == membership.role
        && request.resource.data.get('role', '') == membership.role
        && request.resource.data.get('status', '') == 'Active'
        && request.resource.data.updatedAt == request.time;
    }

    function validMembershipData(academyId, uid) {
      return request.resource.data.keys().hasAll([
          'userId', 'academyId', 'role', 'status', 'source',
          'joinedAt', 'joinedBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'academyId', 'role', 'status', 'source',
          'approvalClaimId', 'joinedAt', 'joinedBy', 'updatedAt'
        ])
        && request.resource.data.userId == uid
        && request.resource.data.academyId == academyId
        && request.resource.data.role in ['ADMIN', 'COACH']
        && request.resource.data.status in [
          'PENDING', 'ACTIVE', 'SUSPENDED', 'LEFT', 'REVOKED'
        ]
        && request.resource.data.source in [
          'CLAIM_APPROVAL',
          'SUPERADMIN_ASSIGNMENT',
          'LEGACY_MIGRATION',
          'INVITE'
        ]
        && (
          (
            request.resource.data.source == 'CLAIM_APPROVAL'
            && exactDocumentId(
              request.resource.data.get('approvalClaimId', '')
            )
          )
          || (
            request.resource.data.source != 'CLAIM_APPROVAL'
            && !request.resource.data.keys().hasAny(['approvalClaimId'])
          )
        );
    }

    function claimRole(claim) {
      return claim.get('type', '') == 'COACH_JOIN'
        ? 'COACH'
        : claim.get('requestedRole', '');
    }

    function isClaimOwner(claim) {
      return isSignedIn() && claim.get('userId', '') == request.auth.uid;
    }

    function isMatchingAcademyAdminForClaim(claim) {
      let inviteCode = claim.get('inviteCode', '');
      let invite = get(
        /databases/$(database)/documents/academy_invites/$(inviteCode)
      ).data;
      let academyId = invite.get('academyId', '');
      return activeInviteMatchesAcademy(inviteCode, academyId)
        && claim.get('requestedAcademyId', academyId) == academyId
        && hasAcademyRole(academyId, ['ADMIN']);
    }

    function validNewClaim(claimId) {
      return request.resource.data.keys().hasAll([
          'type', 'userId', 'requestedRole', 'inviteCode', 'requestedAcademyId',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'type',
          'userId',
          'userEmail',
          'userName',
          'requestedRole',
          'inviteCode',
          'requestedAcademyId',
          'requestedAcademyName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.type == 'ACADEMY_JOIN'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.requestedRole in ['ADMIN', 'COACH']
        && request.resource.data.status == 'PENDING'
        && validInviteCode(request.resource.data.inviteCode)
        && exactDocumentId(request.resource.data.requestedAcademyId)
        && activeInviteMatchesAcademy(
          request.resource.data.inviteCode,
          request.resource.data.requestedAcademyId
        )
        && claimId == request.resource.data.userId
          + '_' + request.resource.data.requestedRole
          + '_' + request.resource.data.inviteCode
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function claimIdentityIsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'approvedAt',
        'approvedBy',
        'approvedAcademyId',
        'approvedRole',
        'rejectedAt',
        'rejectedBy',
        'updatedAt'
      ]);
    }

    function approvedClaimMatchesMembership(claimId) {
      let academyId = request.resource.data.get('approvedAcademyId', '');
      let uid = resource.data.get('userId', '');
      let membership = getAfter(
        /databases/$(database)/documents/academies/$(academyId)/members/$(uid)
      ).data;
      return academyId != ''
        && membership.get('userId', '') == uid
        && membership.get('academyId', '') == academyId
        && membership.get('status', '') == 'ACTIVE'
        && membership.get('role', '') == claimRole(resource.data)
        && membership.get('source', '') == 'CLAIM_APPROVAL'
        && membership.get('approvalClaimId', '') == claimId;
    }

    function validClaimApproval(claimId) {
      let inviteCode = resource.data.get('inviteCode', '');
      let invite = get(
        /databases/$(database)/documents/academy_invites/$(inviteCode)
      ).data;
      let academyId = invite.get('academyId', '');
      return request.resource.data.status == 'APPROVED'
        && activeInviteMatchesAcademy(inviteCode, academyId)
        && resource.data.get('requestedAcademyId', academyId) == academyId
        && request.resource.data.get('approvedAcademyId', '') == academyId
        && request.resource.data.get('approvedRole', '') == claimRole(resource.data)
        && request.resource.data.updatedAt == request.time
        && approvedClaimMatchesMembership(claimId)
        && (
          (
            resource.data.status == 'PENDING'
            && request.resource.data.approvedAt == request.time
            && request.resource.data.approvedBy == request.auth.uid
          )
          || (
            resource.data.status == 'APPROVED'
            && request.resource.data.approvedAt == resource.data.approvedAt
            && request.resource.data.approvedBy == resource.data.approvedBy
            && request.resource.data.approvedAcademyId == resource.data.approvedAcademyId
            && request.resource.data.approvedRole == resource.data.approvedRole
          )
        );
    }

    function validClaimRejection() {
      return resource.data.status == 'PENDING'
        && request.resource.data.status == 'REJECTED'
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.rejectedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function claimReviewerMayUpdate() {
      return isSuperAdmin()
        || isMatchingAcademyAdminForClaim(resource.data);
    }

    function claimApprovalReferenceMatches(academyId, uid) {
      let claimId = request.resource.data.get('approvalClaimId', '');
      let claim = getAfter(
        /databases/$(database)/documents/profile_claims/$(claimId)
      ).data;
      return exactDocumentId(claimId)
        && existsAfter(
          /databases/$(database)/documents/profile_claims/$(claimId)
        )
        && claim.get('status', '') == 'APPROVED'
        && claim.get('userId', '') == uid
        && claim.get('approvedAcademyId', '') == academyId
        && claim.get('approvedRole', '') == request.resource.data.role
        && activeInviteMatchesAcademy(
          claim.get('inviteCode', ''),
          academyId
        )
        && claim.get('requestedAcademyId', academyId) == academyId;
    }

    function validMembershipApprovalReference(academyId, uid) {
      return request.resource.data.source != 'CLAIM_APPROVAL'
        || claimApprovalReferenceMatches(academyId, uid);
    }

    function membershipApprovalReferenceIsStable() {
      return (
          resource.data.get('source', '') == request.resource.data.source
          && (
            resource.data.get('approvalClaimId', '')
              == request.resource.data.get('approvalClaimId', '')
            || (
              resource.data.source == 'CLAIM_APPROVAL'
              && resource.data.get('approvalClaimId', '') == ''
            )
          )
        )
        || (
          resource.data.get('source', '') != 'CLAIM_APPROVAL'
          && request.resource.data.source == 'CLAIM_APPROVAL'
        );
    }

    function validAcademyInviteData(inviteCode) {
      return request.resource.data.keys().hasAll([
          'inviteCode', 'academyId', 'status',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'inviteCode', 'academyId', 'status',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && validInviteCode(inviteCode)
        && request.resource.data.inviteCode == inviteCode
        && exactDocumentId(request.resource.data.academyId)
        && exists(
          /databases/$(database)/documents/academies/$(request.resource.data.academyId)
        )
        && request.resource.data.status in ['ACTIVE', 'REVOKED']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validClientRegistrationLog() {
      return request.resource.data.keys().hasAll([
          'action', 'userId', 'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'action', 'userId', 'email', 'requestedRole', 'timestamp'
        ])
        && request.resource.data.action == 'USER_REGISTERED'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;
    }

    function tenantMemberCanRead(academyId) {
      return isSuperAdmin() || isActiveAcademyMember(academyId);
    }

    function tenantFootballCanWrite(academyId) {
      return isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN', 'COACH']);
    }

    // PLAYER/PARENT access is intentionally separate from tenant staff access.
    // Academy pointers are trusted link metadata because owners cannot update them.
    function hasActiveNonStaffAcademyPointer(academyId, roles) {
      let user = currentUserData();
      return isSignedIn()
        && userExists(request.auth.uid)
        && exactDocumentId(academyId)
        && user.get('role', '') in roles
        && user.get('status', '') in ['ACTIVE', 'Active']
        && user.get('academyId', '') == academyId;
    }

    function canReadLinkedPlayer(academyId, playerId, player) {
      let user = currentUserData();
      return hasActiveNonStaffAcademyPointer(academyId, ['PLAYER', 'PARENT'])
        && exactDocumentId(playerId)
        && (
          (
            user.get('role', '') == 'PLAYER'
            && player.get('linkedUserId', '') == request.auth.uid
          )
          || (
            user.get('role', '') == 'PARENT'
            && exactDocumentId(user.get('linkedPlayerId', ''))
            && user.get('linkedPlayerId', '') == playerId
          )
        );
    }

    function canListOwnPlayerProfile(academyId, player) {
      return hasActiveNonStaffAcademyPointer(academyId, ['PLAYER'])
        && player.get('linkedUserId', '') == request.auth.uid;
    }

    function canAccessLinkedPlayerPath(academyId, playerId) {
      return exists(
          /databases/$(database)/documents/academies/$(academyId)/players/$(playerId)
        )
        && canReadLinkedPlayer(
          academyId,
          playerId,
          get(
            /databases/$(database)/documents/academies/$(academyId)/players/$(playerId)
          ).data
        );
    }

    function canWriteOwnPlayerPath(academyId, playerId) {
      return hasActiveNonStaffAcademyPointer(academyId, ['PLAYER'])
        && canAccessLinkedPlayerPath(academyId, playerId);
    }

    function parentHasLinkedPlayerAccess(academyId) {
      let playerId = currentUserData().get('linkedPlayerId', '');
      return hasActiveNonStaffAcademyPointer(academyId, ['PARENT'])
        && exactDocumentId(playerId)
        && canAccessLinkedPlayerPath(academyId, playerId);
    }

    function parentHasCanonicalPlayerLink() {
      let academyId = currentUserData().get('academyId', '');
      return exactDocumentId(academyId)
        && parentHasLinkedPlayerAccess(academyId);
    }

    function parentCanReadLinkedMatch(academyId, matchData) {
      let playerId = currentUserData().get('linkedPlayerId', '');
      let playerIds = matchData.get('playerIds', []);
      return parentHasLinkedPlayerAccess(academyId)
        && playerIds is list
        && playerId in playerIds;
    }

    function recordPlayerId(data) {
      return data.get('playerId', data.get('player_id', ''));
    }

    function canReadLinkedPlayerRecord(academyId, data) {
      let playerId = recordPlayerId(data);
      return exactDocumentId(playerId)
        && canAccessLinkedPlayerPath(academyId, playerId);
    }

    function parentCanReadOwnObservation(academyId, data) {
      let playerId = data.get('playerId', '');
      return hasActiveNonStaffAcademyPointer(academyId, ['PARENT'])
        && data.get('academyId', academyId) == academyId
        && data.get('creatorId', '') == request.auth.uid
        && exactDocumentId(playerId)
        && canAccessLinkedPlayerPath(academyId, playerId);
    }

    function validParentObservationCreate(academyId) {
      return parentCanReadOwnObservation(academyId, request.resource.data)
        && request.resource.data.get('source', '') == 'PARENT';
    }

    function parentObservationIdentityUnchanged() {
      return request.resource.data.get('academyId', '') == resource.data.get('academyId', '')
        && request.resource.data.get('creatorId', '') == resource.data.get('creatorId', '')
        && request.resource.data.get('playerId', '') == resource.data.get('playerId', '')
        && request.resource.data.get('source', '') == resource.data.get('source', '');
    }

    function parentSessionOwner(academyId, data) {
      let playerId = data.get('playerId', '');
      return hasActiveNonStaffAcademyPointer(academyId, ['PARENT'])
        && data.get('academyId', '') == academyId
        && data.get('creatorId', '') == request.auth.uid
        && data.get('source', '') == 'PARENT'
        && exactDocumentId(playerId)
        && canAccessLinkedPlayerPath(academyId, playerId);
    }

    function parentSessionIdentityUnchanged() {
      return request.resource.data.get('academyId', '') == resource.data.get('academyId', '')
        && request.resource.data.get('creatorId', '') == resource.data.get('creatorId', '')
        && request.resource.data.get('playerId', '') == resource.data.get('playerId', '')
        && request.resource.data.get('source', '') == resource.data.get('source', '');
    }

    match /users/{uid} {
      allow read: if isOwnUserDocument(uid) || isSuperAdmin();
      allow create: if isOwnUserDocument(uid) && validRegistrationUser(uid);
      allow update: if isSuperAdmin()
        || (
          isOwnUserDocument(uid)
          && (
            safeOwnerProfileUpdate()
            || userPointerUpdateMatchesActiveMembership(uid)
          )
        );
      allow delete: if false;
    }

    match /academy_invites/{inviteCode} {
      allow get: if isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.get('inviteCode', '') == inviteCode
          && resource.data.get('status', '') == 'ACTIVE'
          && validInviteCode(inviteCode)
        );
      allow list: if false;
      allow create: if isSuperAdmin()
        && validAcademyInviteData(inviteCode)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSuperAdmin()
        && validAcademyInviteData(inviteCode)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isSuperAdmin();
    }

    match /academies/{academyId} {
      allow read: if tenantMemberCanRead(academyId);
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']);

      match /members/{uid} {
        allow read: if isSuperAdmin()
          || isOwnUserDocument(uid)
          || hasAcademyRole(academyId, ['ADMIN']);
        allow create: if validMembershipData(academyId, uid)
          && validMembershipApprovalReference(academyId, uid)
          && (isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']))
          && request.resource.data.joinedBy == request.auth.uid
          && request.resource.data.joinedAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if validMembershipData(academyId, uid)
          && membershipApprovalReferenceIsStable()
          && (
            (
              resource.data.get('source', '') == request.resource.data.source
              && resource.data.get('approvalClaimId', '')
                == request.resource.data.get('approvalClaimId', '')
            )
            || validMembershipApprovalReference(academyId, uid)
          )
          && (isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']))
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.joinedBy == resource.data.joinedBy
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /coaches/{coachProfileId} {
        allow read: if tenantMemberCanRead(academyId);
        allow create, update: if isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']);
        allow delete: if isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']);
      }

      match /players/{playerId} {
        allow get: if canReadLinkedPlayer(academyId, playerId, resource.data)
          || tenantMemberCanRead(academyId);
        allow list: if canListOwnPlayerProfile(academyId, resource.data)
          || tenantMemberCanRead(academyId);
        allow create, update, delete: if tenantFootballCanWrite(academyId);

        match /{playerCollection}/{document=**} {
          allow read: if tenantMemberCanRead(academyId)
            || canAccessLinkedPlayerPath(academyId, playerId);
          allow write: if tenantFootballCanWrite(academyId)
            || (
              playerCollection in [
                'daily_logs',
                'daily_wellness',
                'goals',
                'journals',
                'attendance'
              ]
              && canWriteOwnPlayerPath(academyId, playerId)
            );
        }
      }

      match /matches/{document=**} {
        allow read: if parentCanReadLinkedMatch(academyId, resource.data)
          || tenantMemberCanRead(academyId);
        allow write: if tenantFootballCanWrite(academyId);
      }

      match /training_weeks/{document=**} {
        allow read: if tenantMemberCanRead(academyId);
        allow write: if tenantFootballCanWrite(academyId);
      }

      match /idps/{document=**} {
        allow read: if tenantMemberCanRead(academyId)
          || canReadLinkedPlayerRecord(academyId, resource.data);
        allow write: if tenantFootballCanWrite(academyId);
      }

      match /player_evaluations/{document=**} {
        allow read: if tenantMemberCanRead(academyId)
          || canReadLinkedPlayerRecord(academyId, resource.data);
        allow write: if tenantFootballCanWrite(academyId);
      }

      match /fitness_tests/{document=**} {
        allow read: if tenantMemberCanRead(academyId)
          || canReadLinkedPlayerRecord(academyId, resource.data);
        allow write: if tenantFootballCanWrite(academyId);
      }

      match /attendance/{document=**} {
        allow read: if tenantMemberCanRead(academyId);
        allow write: if tenantFootballCanWrite(academyId);
      }

      match /tournaments/{document=**} {
        allow read: if tenantMemberCanRead(academyId);
        allow write: if tenantFootballCanWrite(academyId);
      }

      match /observation_profiles/{document=**} {
        allow read: if tenantMemberCanRead(academyId)
          || parentHasLinkedPlayerAccess(academyId);
        allow write: if isSuperAdmin() || hasAcademyRole(academyId, ['ADMIN']);
      }

      match /observation_sessions/{document=**} {
        allow read: if tenantMemberCanRead(academyId)
          || parentSessionOwner(academyId, resource.data);
        allow create: if tenantFootballCanWrite(academyId)
          || parentSessionOwner(academyId, request.resource.data);
        allow update: if tenantFootballCanWrite(academyId)
          || (
            parentSessionOwner(academyId, resource.data)
            && parentSessionOwner(academyId, request.resource.data)
            && parentSessionIdentityUnchanged()
          );
        allow delete: if tenantFootballCanWrite(academyId)
          || parentSessionOwner(academyId, resource.data);
      }

      match /observation_live_events/{document=**} {
        allow read: if tenantMemberCanRead(academyId)
          || parentCanReadOwnObservation(academyId, resource.data);
        allow create: if tenantFootballCanWrite(academyId)
          || validParentObservationCreate(academyId);
        allow update: if tenantFootballCanWrite(academyId)
          || (
            parentCanReadOwnObservation(academyId, resource.data)
            && validParentObservationCreate(academyId)
            && parentObservationIdentityUnchanged()
          );
        allow delete: if tenantFootballCanWrite(academyId)
          || parentCanReadOwnObservation(academyId, resource.data);
      }

      match /observation_reflections/{document=**} {
        allow read: if tenantMemberCanRead(academyId)
          || parentCanReadOwnObservation(academyId, resource.data);
        allow create: if tenantFootballCanWrite(academyId)
          || validParentObservationCreate(academyId);
        allow update: if tenantFootballCanWrite(academyId)
          || (
            parentCanReadOwnObservation(academyId, resource.data)
            && validParentObservationCreate(academyId)
            && parentObservationIdentityUnchanged()
          );
        allow delete: if tenantFootballCanWrite(academyId)
          || parentCanReadOwnObservation(academyId, resource.data);
      }

      match /{collectionName}/{document=**} {
        allow read: if collectionName in [
            'messages',
            'proPlayers',
            'events',
            'activity_logs',
            'evaluation_criteria',
            'match_plans',
            'scoutPlayers'
          ]
          && tenantMemberCanRead(academyId);
        allow write: if collectionName in [
            'messages',
            'proPlayers',
            'events',
            'activity_logs',
            'evaluation_criteria',
            'match_plans',
            'scoutPlayers'
          ]
          && tenantFootballCanWrite(academyId);
      }
    }

    match /profile_claims/{claimId} {
      allow create: if isSignedIn() && validNewClaim(claimId);
      allow read: if isSignedIn()
        && (
          isClaimOwner(resource.data)
          || isMatchingAcademyAdminForClaim(resource.data)
          || isSuperAdmin()
        );
      allow update: if isSignedIn()
        && claimIdentityIsUnchanged()
        && claimReviewerMayUpdate()
        && (validClaimApproval(claimId) || validClaimRejection());
      allow delete: if false;
    }

    match /settings/{document=**} {
      allow read, write: if false;
    }

    match /logs/{document=**} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        || (isSignedIn() && validClientRegistrationLog());
      allow update, delete: if false;
    }

    match /drills/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow create: if isSuperAdmin();
      allow update: if isSignedIn()
        && resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn()
        && resource.data.get('userId', '') == request.auth.uid;
    }

    match /parent_observation_metrics/{document=**} {
      allow read, write: if isSuperAdmin();
    }

    match /parent_match_observations/{document=**} {
      allow read: if isSuperAdmin()
        || (
          exactDocumentId(resource.data.get('academyId', ''))
          && isActiveAcademyMember(resource.data.academyId)
        );
      allow create: if isSuperAdmin()
        || (
          exactDocumentId(request.resource.data.get('academyId', ''))
          && isActiveAcademyMember(request.resource.data.academyId)
        );
      allow update: if isSuperAdmin()
        || (
          request.resource.data.get('academyId', '')
            == resource.data.get('academyId', '')
          && request.resource.data.get('parentId', '')
            == resource.data.get('parentId', '')
          && request.resource.data.get('playerId', '')
            == resource.data.get('playerId', '')
          && isActiveAcademyMember(resource.data.get('academyId', ''))
        );
      allow delete: if isSuperAdmin();
    }

    match /observation_metrics/{document=**} {
      allow read: if isSuperAdmin() || parentHasCanonicalPlayerLink();
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
