{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --project demo-futverse-membership --only firestore \"node --import tsx --test tests/firestore.membership.rules.test.ts\"",
    "test:admin-decisions": "firebase emulators:exec --project demo-futverse-admin-decisions --only firestore \"node --import tsx --test tests/firestore.admin-user-decision.rules.test.ts\"",
    "test:backfill-dry-run": "node --import tsx --test tests/membershipBackfillDryRun.test.ts",
    "test:membership-export": "node --import tsx --test tests/membershipExportReadOnly.test.ts",
    "export:membership-planning": "node --import tsx scripts/membershipExportReadOnly.ts",
    "test:bootstrap-legacy-admin": "node --import tsx --test tests/bootstrapLegacyAdmin.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "konva": "^10.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-konva": "^19.2.5",
    "recharts": "^3.8.1",
    "use-image": "^1.1.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "15.22.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
