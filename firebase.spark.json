{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.spark.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "node scripts/verifyProductionAppCheck.mjs",
      "npm run build"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
