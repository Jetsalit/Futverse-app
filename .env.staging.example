# FutVerse isolated staging only. Never point these values at production.
VITE_FUTVERSE_ENV=staging

# Server/deploy-only project selector. Must equal VITE_FIREBASE_PROJECT_ID.
# Keep .firebaserc fail-closed if preferred; this value is passed explicitly to Firebase CLI.
FIREBASE_STAGING_PROJECT_ID=futverse-staging-CHANGE_ME

VITE_FIREBASE_PROJECT_ID=futverse-staging-CHANGE_ME
VITE_FIREBASE_APP_ID=CHANGE_ME
VITE_FIREBASE_API_KEY=CHANGE_ME
VITE_FIREBASE_AUTH_DOMAIN=futverse-staging-CHANGE_ME.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=futverse-staging-CHANGE_ME.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
VITE_FIREBASE_MEASUREMENT_ID=

# Configure only after Firebase App Check is enabled for the staging web app.
VITE_RECAPTCHA_SITE_KEY=CHANGE_ME

# Deployment safeguards are intentionally NOT stored here:
# EXPECTED_STAGING_HEAD=<exact git SHA>
# STAGING_DEPLOY_CONFIRM=DEPLOY_STAGING_ONLY   # execute mode only
